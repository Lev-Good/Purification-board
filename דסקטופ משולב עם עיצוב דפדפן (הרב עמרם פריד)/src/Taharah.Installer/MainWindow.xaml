<Window x:Class="Taharah.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="התקנת לוח טהרה — הרב עמרם פריד שליט״א" 
        Height="460" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#FAF9F6"
        FontFamily="Segoe UI, Tahoma">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
            <RowDefinition Height="65" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E3A5F" Padding="24,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="התקנת לוח טהרה (הרב עמרם פריד שליט״א)" 
                           Foreground="White" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="גרסה משולבת דסקטופ ודפדפן — התקנה מקומית מאובטחת" 
                           Foreground="#94A3B8" FontSize="12.5" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="28,20">
            <!-- Initial & Installing Step Panel -->
            <StackPanel x:Name="SetupPanel">
                <TextBlock Text="נתיב התקנה:" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathTextBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center" 
                             Padding="8,0" Background="White" BorderBrush="#CBD5E1" FontSize="12.5" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="עיון..." Margin="8,0,0,0" Height="32" 
                            Background="#F1F5F9" BorderBrush="#CBD5E1" Click="BrowseButton_Click" Cursor="Hand" />
                </Grid>

                <TextBlock Text="אפשרויות נוספות:" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,8" />
                <CheckBox x:Name="DesktopShortcutCheckBox" Content="צור קיצור דרך על שולחן העבודה" IsChecked="True" Margin="0,0,0,8" FontSize="13" />
                <CheckBox x:Name="StartMenuShortcutCheckBox" Content="צור קיצור דרך בתפריט 'התחלה'" IsChecked="True" Margin="0,0,0,8" FontSize="13" />
                <CheckBox x:Name="LaunchAfterCheckBox" Content="הפעל את לוח טהרה בסיום ההתקנה" IsChecked="True" Margin="0,0,0,16" FontSize="13" />

                <!-- Progress -->
                <TextBlock x:Name="StatusTextBlock" Text="לחצי על 'התקן' כדי להתחיל בתהליך ההתקנה." 
                           FontSize="12.5" Foreground="#64748B" Margin="0,0,0,8" />
                <ProgressBar x:Name="InstallProgressBar" Height="14" Minimum="0" Maximum="100" Value="0" 
                             Foreground="#1E3A5F" Background="#E2E8F0" BorderThickness="0" />
            </StackPanel>

            <!-- Complete Step Panel -->
            <StackPanel x:Name="CompletePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="✓" FontSize="48" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="ההתקנה הושלמה בהצלחה!" FontSize="20" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="לוח טהרה הותקן בהצלחה במחשבך ומוכן לשימוש." FontSize="13.5" Foreground="#64748B" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button x:Name="ActionButton" Content="התקן" Width="100" Height="36" 
                        Background="#1E3A5F" Foreground="White" FontWeight="Bold" FontSize="13" 
                        BorderThickness="0" Cursor="Hand" Click="ActionButton_Click" />
                <Button x:Name="CancelButton" Content="ביטול" Width="80" Height="36" Margin="12,0,0,0" 
                        Background="White" Foreground="#475569" BorderBrush="#CBD5E1" FontSize="13" 
                        Cursor="Hand" Click="CancelButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
