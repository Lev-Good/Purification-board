<!-- ============================================================================
     מערכת העיצוב של לוח טהרה — סבב עיצוב מחדש מלא (2026-09-28)
     ============================================================================
     קובץ זה הוא שכבת ה"מותג" בלבד: טיפוגרפיה, ריווח, ותבניות/סגנונות לבקרות
     הליבה. הוא **אינו** נושא צבעים - כל צבע נקרא כ-DynamicResource מתוך
     Themes/LightTheme.xaml / Themes/DarkTheme.xaml, ולכן החלפת מצב יום/לילה
     מתעדכנת בכל מקום אוטומטית (זה בדיוק מה שהיה שבור קודם: צבעי hex קשיחים
     ב-XAML לא ידעו להתהפך עם הערכה).

     שמו בכוונה אינו מכיל "Theme.xaml" - ThemeService.Apply מחפש את הרשומה
     ששמה מכיל "Theme.xaml" ומחליף אותה בקובץ הערכה הנבחר, וקובץ זה חייב
     להישאר קבוע ולא להיות מוחלף.

     עקרון: אין כאן סגנונות Implicit (TargetType ללא x:Key). סגנון implicit
     על ui:Button היה תופס גם את הכפתורים הפנימיים בתבניות של DatePicker
     ו-ComboBox ומעוות אותם. כל סגנון נקרא בשמו המפורש בלבד.

     חשוב - BasedOn חובה בכל סגנון על בקר של Wpf.Ui:
     ברירות המחדל של Wpf.Ui (Button/Card/Badge/...) הן סגנונות implicit שמפתחם
     הוא הטיפוס עצמו, והן אלה שנושאות את ה-ControlTemplate, את רינדור ה-Icon
     ואת התנהגות ה-Appearance (ראשי/משני/שקוף) ואת פינות ההצטרפות. ברגע
     שמגדירים Style מפורש בלי BasedOn, הסגנון הזה דורס את ברירת המחדל כולה
     והבקר נופל חזרה לתבנית ה-WPF הקלאסית: כפתור אפור מרובע בלי אייקון,
     תגית בלי רקע, כרטיס שטוח. לכן כל סגנון-שורש על בקר של Wpf.Ui יורש
     במפורש מהברירה של Wpf.Ui, ומעליה מוסיף/דורס רק את מה שאנחנו רוצים.
     ============================================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui">

    <!-- ==================== 1. טיפוגרפיה ==================== -->

    <!-- "Segoe UI Variable Text" מגיע עם Windows 11; ה-fallback chain מכסה
         Windows 10 (Segoe UI) וגם התקנות שבהן אין Arial Hebrew. -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Arial Hebrew, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- סולם גדלים:
         Display 22 · Title 17 · Subtitle 14.5 · Body 13 · Small 12 · Caption 11 · Micro 10 -->

    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SecondaryBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MicroTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- כותרת מקטע בתוך כרטיס: 14/Bold עם רווח תחתון -->
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- שורת הסבר מתחת לכותרת מקטע -->
    <Style x:Key="SectionCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- תווית שדה בטופס (מעל התיבה) -->
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- הודעת סטטוס מתחת לפעולה (הצלחה/שגיאה/מידע) -->
    <Style x:Key="StatusMessageTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource InfoFgBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- גליף אייקון מפונט המערכת (לא אמוג'י - ראו דוח סקירת הממשק §2.3) -->
    <Style x:Key="IconGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <!-- ==================== 2. ריווח ==================== -->

    <Thickness x:Key="PageMarginThickness">20</Thickness>
    <Thickness x:Key="CardPaddingThickness">16</Thickness>
    <Thickness x:Key="CardPaddingCompactThickness">12</Thickness>
    <Thickness x:Key="SectionMarginThickness">0,0,0,14</Thickness>
    <Thickness x:Key="HeaderMarginThickness">0,0,0,16</Thickness>
    <Thickness x:Key="InlineGapThickness">0,0,8,0</Thickness>
    <Thickness x:Key="InlineGapSmallThickness">0,0,6,0</Thickness>

    <!-- ==================== 3. כרטיסים ==================== -->

    <Style x:Key="AppCardStyle" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource CardPaddingThickness}"/>
    </Style>

    <!-- כרטיס מקטע בעמודים ארוכים (הגדרות/אודות/מדריך) - כותרת+הסבר+תוכן -->
    <Style x:Key="AppSectionCardStyle" TargetType="ui:Card" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="Margin" Value="{StaticResource SectionMarginThickness}"/>
    </Style>

    <!-- כרטיס פנימי מוקטן (פריט ברשימה מקוננת) -->
    <Style x:Key="AppNestedCardStyle" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource CardPaddingCompactThickness}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ==================== 4. כפתורים ==================== -->

    <Style x:Key="AppButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- כפתור בסרגל הכלים: ריווח מצומצם ואחיד -->
    <Style x:Key="ToolbarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- כפתור אייקון מרובע (34x34) - לפעולות מערכת ולדפדוף -->
    <Style x:Key="IconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- כפתור אייקון שקוף (סגירת מגירה X וכו') - עם Background שקוף מלא כדי לקלוט לחיצות בכל השטח -->
    <Style x:Key="SubtleIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
    </Style>

    <!-- כפתור מחיקה עדין ברשימות (32x32) -->
    <Style x:Key="SubtleDeleteButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="4"/>
    </Style>

    <!-- עיצוב גלובלי לתיבות סימון (CheckBox / RadioButton) - גופן אחיד וסמן יד -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Appearance" Value="Primary"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- אריח פעולה מהירה במגירת היום: שתי עמודות, אייקון מעל טקסט, גובה אחיד -->
    <Style x:Key="ActionTileButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,11"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="MinHeight" Value="62"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ==================== 5. תגיות (Badge) ==================== -->

    <!-- צביעת תגית לפי BadgeCategory.determineDayStatus. הצבעים מגיעים מהערכה
         כ-DynamicResource, ולכן הן מצב יום והן מצב לילה נכונים ומתחלפים מיד -
         שלא כמו הממירים הקודמים (BadgeBackgroundConverter) שהחזיקו hex בהיר
         קבוע בקוד ולא ידעו להתהפך. -->
    <Style x:Key="CategoryBadgeStyle" TargetType="ui:Badge" BasedOn="{StaticResource {x:Type ui:Badge}}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Background" Value="{DynamicResource NeutralBadgeBgBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource NeutralBadgeFgBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Category}" Value="Sighting">
                <Setter Property="Background" Value="{DynamicResource SightingBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource SightingFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="PrishaDay">
                <Setter Property="Background" Value="{DynamicResource PrishaDayBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrishaDayFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="PrishaNight">
                <Setter Property="Background" Value="{DynamicResource PrishaNightBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrishaNightFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="OrZarua">
                <Setter Property="Background" Value="{DynamicResource OrZaruaBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OrZaruaFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Hefsek">
                <Setter Property="Background" Value="{DynamicResource HefsekBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource HefsekFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="ShevaNekiyim">
                <Setter Property="Background" Value="{DynamicResource NekiimBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource NekiimFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Mikveh">
                <Setter Property="Background" Value="{DynamicResource MikvehBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MikvehFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Check">
                <Setter Property="Background" Value="{DynamicResource CheckBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource CheckFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Mark">
                <Setter Property="Background" Value="{DynamicResource MarkBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MarkFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Fertility">
                <Setter Property="Background" Value="{DynamicResource FertilityBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FertilityFgBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Ovulation">
                <Setter Property="Background" Value="{DynamicResource OvulationBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OvulationFgBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== 6. צ'יפים ופאנלים ==================== -->

    <!-- צ'יפ מידע קטן (נץ / שקיעה / סטטוס) -->
    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <!-- פאנל התראה רוחבי (מצב יום: פחד פתאום / אור זרוע / חרדה) -->
    <Style x:Key="AlertPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="20,10"/>
    </Style>

    <!-- אזהרה בתוך תוכן (התרעת פוריות, מחלוקת פוסקים) -->
    <Style x:Key="InlineAlertBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WarningBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- מפריד דק בין מקטעים -->
    <Style x:Key="DividerBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,12,0,12"/>
    </Style>

</ResourceDictionary>
