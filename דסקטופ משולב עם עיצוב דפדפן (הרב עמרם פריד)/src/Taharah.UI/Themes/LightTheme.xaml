<!-- ============================================================================
     ערכת מצב בהיר — סט הטוקנים הסמנטיים של המערכת (2026-09-28)
     ============================================================================
     כל צבע באפליקציה מוגדר כאן בשם סמנטי, ואף קובץ XAML אינו מכיל hex בעצמו.
     DarkTheme.xaml מגדיר את **אותם מפתחות בדיוק** בערכי לילה, ו-ThemeService
     מחליף ביניהם - ולכן כל מסך מתהפך נכון בלי לגעת בכלום.

     אין להוסיף צבע ל-XAML ישירות. אין להוסיף מפתח רק לאחת מהערכות.
     ============================================================================ -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== משטחים וטקסט ==================== -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#374151"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#F3F5F9"/>

    <!-- ==================== מיתוג ==================== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#EEF0FF"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

    <!-- ==================== אינטראקציה ==================== -->
    <SolidColorBrush x:Key="HoverTintBrush" Color="#F1F5FF"/>
    <SolidColorBrush x:Key="SelectedTintBrush" Color="#EEF0FF"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#66101828"/>

    <!-- ==================== סמנטי כללי ==================== -->
    <SolidColorBrush x:Key="DangerFgBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA"/>
    <SolidColorBrush x:Key="SuccessFgBrush" Color="#047857"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="WarningFgBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="WarningStrongFgBrush" Color="#92400E"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FDE68A"/>
    <SolidColorBrush x:Key="InfoFgBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#F0F9FF"/>
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#BAE6FD"/>

    <!-- ==================== משבצת יום בלוח ==================== -->
    <SolidColorBrush x:Key="DayTileBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DayTileBorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="DayTileHoverBrush" Color="#F7F9FE"/>
    <SolidColorBrush x:Key="MutedDayBgBrush" Color="#F1F3F7"/>
    <SolidColorBrush x:Key="TodayRingBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="SelectedRingBrush" Color="#4F46E5"/>

    <!-- ==================== תגיות לפי סוג ==================== -->
    <!-- ראייה (דם) -->
    <SolidColorBrush x:Key="SightingBgBrush" Color="#FDE7E7"/>
    <SolidColorBrush x:Key="SightingFgBrush" Color="#B91C1C"/>
    <!-- עונת פרישה - יום -->
    <SolidColorBrush x:Key="PrishaDayBgBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="PrishaDayFgBrush" Color="#92400E"/>
    <!-- עונת פרישה - לילה -->
    <SolidColorBrush x:Key="PrishaNightBgBrush" Color="#E4E7FD"/>
    <SolidColorBrush x:Key="PrishaNightFgBrush" Color="#3730A3"/>
    <!-- עונת אור זרוע -->
    <SolidColorBrush x:Key="OrZaruaBgBrush" Color="#ECF1F6"/>
    <SolidColorBrush x:Key="OrZaruaFgBrush" Color="#475569"/>
    <!-- הפסק טהרה -->
    <SolidColorBrush x:Key="HefsekBgBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="HefsekFgBrush" Color="#15803D"/>
    <!-- שבעה נקיים -->
    <SolidColorBrush x:Key="NekiimBgBrush" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="NekiimFgBrush" Color="#0369A1"/>
    <!-- טבילה -->
    <SolidColorBrush x:Key="MikvehBgBrush" Color="#CCFBF1"/>
    <SolidColorBrush x:Key="MikvehFgBrush" Color="#0F766E"/>
    <!-- בדיקה -->
    <SolidColorBrush x:Key="CheckBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="CheckFgBrush" Color="#334155"/>
    <!-- סימון יום / כתם -->
    <SolidColorBrush x:Key="MarkBgBrush" Color="#FEF9C3"/>
    <SolidColorBrush x:Key="MarkFgBrush" Color="#854D0E"/>
    <!-- חלון פוריות -->
    <SolidColorBrush x:Key="FertilityBgBrush" Color="#E6FFFB"/>
    <SolidColorBrush x:Key="FertilityFgBrush" Color="#0F766E"/>
    <!-- יום ביוץ משוער -->
    <SolidColorBrush x:Key="OvulationBgBrush" Color="#99F6E4"/>
    <SolidColorBrush x:Key="OvulationFgBrush" Color="#115E59"/>
    <!-- נטרלי -->
    <SolidColorBrush x:Key="NeutralBadgeBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="NeutralBadgeFgBrush" Color="#475569"/>

</ResourceDictionary>
