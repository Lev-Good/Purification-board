<UserControl x:Class="Taharah.UI.Views.AboutDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="540"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="AboutBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="AboutBodyLastStyle" TargetType="TextBlock" BasedOn="{StaticResource AboutBodyStyle}">
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource WindowBgBrush}">
        <Grid Margin="22,18,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <ui:Button DockPanel.Dock="Left" Command="{Binding CloseAboutCommand}"
                           Click="OnCloseAboutClicked"
                           Style="{StaticResource SubtleIconButtonStyle}" ToolTip="סגור (Esc)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <StackPanel>
                    <TextBlock Text="אודות והוראות שימוש" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="לוח טהרה — מהדורת הלכות טהרה (הרב עמרם פריד)"
                               Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,22">

                    <!-- 1. איך משתמשים -->
                    <ui:Card Style="{StaticResource AppSectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="BookOpen24" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="איך משתמשים ביומן?" Style="{StaticResource SubtitleTextStyle}"/>
                            </StackPanel>

                            <TextBlock Style="{StaticResource AboutBodyStyle}">
                                <Run Text="הזנת נתונים: " FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                <Run Text="לחצו על כל תאריך בלוח השנה כדי לפתוח את תפריט הפעולות ליום זה."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutBodyStyle}">
                                <Run Text="תחילת מחזור (ראייה): " FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                <Run Text="סמנו &quot;ראייה&quot; ובחרו אם זה קרה בעונת יום או בעונת לילה. המערכת תחשב מיד את ימי הפרישה העתידיים."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutBodyStyle}">
                                <Run Text="הבנת התצוגה בלוח (יום מול לילה): " FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                <Run Text="ביהדות הלילה קודם ליום. אירועים שחלים בלילה שלפני היום עצמו (כגון טבילה) מסומנים בלוח בהתאם."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutBodyStyle}">
                                <Run Text="תהליך הטהרה: " FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                <Run Text="ביום ביצוע &quot;הפסק טהרה&quot; סמנו זאת בלוח. המערכת תציג אוטומטית את שבעת הנקיים ותסמן את צפי הטבילה ללילה הנכון."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutBodyLastStyle}">
                                <Run Text="לפירוט מלא של כל קיצור וקוד שמופיע בלוח (עו&quot;ב, עו&quot;ה, יו&quot;ח, עוא&quot;ז, עו&quot;מ, וק&quot;ח ועוד), עם מקורות הלכתיים מלאים — ראו את "/>
                                <Hyperlink Command="{Binding OpenGuideCommand}"><Run Text="המדריך ההלכתי"/></Hyperlink>
                                <Run Text="."/>
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>

                    <!-- 2. ייצוא במייל -->
                    <ui:Card Style="{StaticResource AppSectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Mail24" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="שליחת נתונים למייל" Style="{StaticResource SubtitleTextStyle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource AboutBodyStyle}"
                                       Text="ניתן לייצא את ריכוז הווסתות וההיסטוריה לכתובת מייל שתבחרו (בהגדרות) — למשל לצורך שיתוף עם רב לייעוץ."/>
                            <TextBlock Style="{StaticResource AboutBodyStyle}">
                                <Run Text="שימו לב (אימות חד־פעמי): " FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                <Run Text="מטעמי אבטחה ומניעת ספאם, בפעם הראשונה שתשלחו לכתובת דוא&quot;ל מסוימת תקבלו לתיבה הודעת אימות באנגלית מ-FormSubmit. חובה לפתוח את ההודעה וללחוץ על 'Activate' כדי שהנתונים יתקבלו בפועל."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutBodyLastStyle}"
                                       Text="בפעמים הבאות שתשלחו לאותה כתובת, הנתונים יגיעו מיד ללא צורך באישור נוסף."/>
                        </StackPanel>
                    </ui:Card>

                    <!-- 3. פרטיות וגיבוי -->
                    <ui:Card Style="{StaticResource AppSectionCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="פרטיות וגיבוי נתונים" Style="{StaticResource SubtitleTextStyle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource AboutBodyStyle}">
                                <Run Text="אבטחה מקסימלית: " FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                <Run Text="כל הנתונים שלכם נשמרים אך ורק על המחשב האישי שלכם. אף נתון לא נשלח לשרת חיצוני, אלא אם תבחרו במפורש לסנכרן ליומן/גיליון Google או לשלוח למייל."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutBodyStyle}">
                                <Run Text="קוד נעילה (PIN): " FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                <Run Text="כדי להגן על היומן מעיניים סקרניות, היכנסו להגדרות והגדירו קוד אישי שיידרש בכל פתיחה של האפליקציה — הוא גם מצפין את קובץ בסיס הנתונים עצמו."/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutBodyLastStyle}">
                                <Run Text="גיבוי חובה: " FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                <Run Text="אנו ממליצים בחום לייצא קובץ גיבוי לעיתים קרובות מתוך ההגדרות. את הקובץ תוכלו לטעון מחדש בכל מחשב."/>
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>

                    <!-- 4. קרדיט -->
                    <ui:Card Style="{StaticResource AppSectionCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Heart24" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="פותח באהבה ובמחשבה רבה על ידי לב טוב" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center" Margin="0,9,0,5"/>
                            <TextBlock Text="לשאלות, הצעות לשיפור או תמיכה טכנית:"
                                       Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock HorizontalAlignment="Center">
                                <Hyperlink NavigateUri="mailto:myylbwt@gmail.com" RequestNavigate="OnEmailLinkRequestNavigate">
                                    <Run Text="myylbwt@gmail.com"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
