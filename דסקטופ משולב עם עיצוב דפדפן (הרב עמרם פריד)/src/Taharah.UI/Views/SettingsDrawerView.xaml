<UserControl x:Class="Taharah.UI.Views.SettingsDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="900"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVis"/>

        <!-- ==================== מסילת ניווט שמאלית (בסגנון הגדרות Win11) ====================
             TabControl ולא NavigationView: NavigationView אמיתי דורש מודל Frame/Page,
             והחלפת תוכן מבוססת טאבים נותנת בדיוק את אותה שפה חזותית בלי לשבור את
             מנגנון המיתוג הקיים. הטאבים הם UI בלבד - אין להם Binding לפקודה כלשהי. -->
        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Margin="0,0,0,4">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedTintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TabPanel Grid.Column="0" IsItemsHost="True" HorizontalAlignment="Stretch" Margin="0,0,0,0"/>
                            <Border Grid.Column="1" BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="0,0,1,0" Margin="0,0,18,0"/>
                            <Border Grid.Column="2" Background="Transparent">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabHeaderStackStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>

        <!-- ==================== שורת הגדרה ====================
             תווית + הסבר מימין, הבקרה משמאל. אותה שורה בדיוק בכל מסך ההגדרות,
             כדי שכל מתג ייראה ויתנהג אותו דבר. -->
        <Style x:Key="SettingRowGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SettingHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="MaxWidth" Value="560"/>
        </Style>

        <Style x:Key="SettingsFieldStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <ui:Card Background="{DynamicResource ApplicationBackgroundBrush}" BorderThickness="1,0,0,0"
             BorderBrush="{DynamicResource AppBorderBrush}" Padding="0">
        <Grid Margin="22,18,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Tabbed options -->
                <RowDefinition Height="Auto"/> <!-- Sticky footer -->
            </Grid.RowDefinitions>

            <!-- ==================== Header ==================== -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <ui:Button DockPanel.Dock="Left" Command="{Binding CloseSettingsCommand}"
                           Click="OnCloseSettingsClicked"
                           Style="{StaticResource SubtleIconButtonStyle}" ToolTip="סגור (Esc)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <StackPanel>
                    <TextBlock Text="הגדרות מערכת והלכה" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="מנהגים, חומרות, מיקום, אבטחה וגיבוי — כולם נשמרים מקומית במכשיר."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- ==================== Tabs ==================== -->
            <TabControl Grid.Row="1" Style="{StaticResource SettingsTabControlStyle}">

                <!-- ==================== Tab: הלכה ומנהגים ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Style="{StaticResource TabHeaderStackStyle}">
                            <TextBlock Text="הלכה ומנהגים" Margin="0,0,9,0"/>
                            <ui:SymbolIcon Symbol="Scales24"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,4">

                            <!-- מצב חיים -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="מצב חיים (מסולקת דמים)" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="מעוברת אחר תשעים יום, מניקה, זקנה וקטנה — דינן שונה: אינן חוששות לוסתות שהיו להן קודם, ומסולקת דמים פטורה מבדיקה. מלאו רק את מה שרלוונטי."
                                               Style="{StaticResource SectionCaptionTextStyle}"/>

                                    <ui:ToggleSwitch Content="הפעל חישוב מצב חיים"
                                                     IsChecked="{Binding SettingsVm.LifeEnabled}" Margin="0,0,0,12"/>

                                    <StackPanel Visibility="{Binding SettingsVm.LifeEnabled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="תחילת ההריון (לפי מניין ליל טבילה):" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <DatePicker SelectedDate="{Binding SettingsVm.LifePregnancyDate, Mode=TwoWay}" Margin="0,0,0,10"/>

                                        <TextBlock Text="תאריך הלידה:" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <DatePicker SelectedDate="{Binding SettingsVm.LifeBirthDate, Mode=TwoWay}" Margin="0,0,0,10"/>

                                        <ui:ToggleSwitch Content="מניקה בימים אלה"
                                                         IsChecked="{Binding SettingsVm.LifeNursing}" Margin="0,0,0,8"/>
                                        <ui:ToggleSwitch IsChecked="{Binding SettingsVm.LifeNursingLenient}" Margin="0,0,0,12">
                                            <ui:ToggleSwitch.Content>
                                                <TextBlock Text="להקל כדעת &quot;דעת טהרה&quot; — לידה והנקה כמסולקת דמים עד כ&quot;ד חודש"
                                                           TextWrapping="Wrap" MaxWidth="470" FontSize="12"/>
                                            </ui:ToggleSwitch.Content>
                                        </ui:ToggleSwitch>

                                        <TextBlock Text="גיל בשנים (לחישוב זקנה וקטנה):" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBox Text="{Binding SettingsVm.LifeAgeYears, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldStyle}" Width="92"
                                                 HorizontalAlignment="Left" Margin="0,0,0,14"/>

                                        <Border Style="{StaticResource DividerBorderStyle}"/>

                                        <TextBlock Text="תקופות נטילת כדורים" Style="{StaticResource FieldLabelTextStyle}"/>

                                        <ItemsControl ItemsSource="{Binding SettingsVm.LifePillPeriods}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Card Style="{StaticResource AppNestedCardStyle}">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,8">
                                                                <ui:Button DockPanel.Dock="Left" Style="{StaticResource SubtleDeleteButtonStyle}"
                                                                           ToolTip="הסר תקופה"
                                                                           Command="{Binding DataContext.SettingsVm.RemovePillPeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           CommandParameter="{Binding}"
                                                                           Click="OnRemovePillPeriodClicked">
                                                                    <ui:Button.Icon>
                                                                        <ui:SymbolIcon Symbol="Delete24"/>
                                                                    </ui:Button.Icon>
                                                                </ui:Button>
                                                                <TextBlock Text="תקופת כדורים" FontSize="12.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </DockPanel>

                                                            <TextBlock Text="סוג הכדורים:" FontSize="11.5" Margin="0,0,0,4"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.SettingsVm.PillTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Type, Mode=TwoWay}" Padding="6,5" Margin="0,0,0,8"/>

                                                            <TextBlock Text="מתאריך:" FontSize="11.5" Margin="0,0,0,4"/>
                                                            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                            <TextBlock Text="עד תאריך (ריק = עדיין נוטלת):" FontSize="11.5" Margin="0,0,0,4"/>
                                                            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Margin="0,0,0,8"/>

                                                            <TextBlock Text="מדוע הפסקתי את הנטילה:" FontSize="11.5" Margin="0,0,0,4"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.SettingsVm.PillStopReasonOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Reason, Mode=TwoWay}" Padding="6,5"/>
                                                        </StackPanel>
                                                    </ui:Card>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ui:Button Content="הוסף תקופת כדורים" Command="{Binding SettingsVm.AddPillPeriodCommand}"
                                                   Style="{StaticResource AppButtonStyle}" Appearance="Secondary"
                                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Add24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>

                            <!-- מנהגים ותצוגה -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="מנהגים ותצוגה" Style="{StaticResource SectionTitleTextStyle}"/>

                                    <TextBlock Text="פרופיל מנהג (שכבה נוחה מעל כמה מתגים — שינוי מתג בודד לאחר מכן חוזר ל&quot;מותאם אישית&quot;):"
                                               Style="{StaticResource SectionCaptionTextStyle}"/>
                                    <ComboBox ItemsSource="{Binding SettingsVm.MinhagProfileOptions}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding SettingsVm.MinhagProfile, Mode=TwoWay}"
                                              Padding="6,5" Margin="0,0,0,14"/>

                                    <ui:ToggleSwitch Content="חשש עונת אור זרוע (עונה שלפני)"
                                                     IsChecked="{Binding SettingsVm.OrZarua}" Margin="0,0,0,10"/>
                                    <ui:ToggleSwitch Content="הצגת חלון פוריות וביוץ משוער בלוח"
                                                     IsChecked="{Binding SettingsVm.ShowFertility}"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- פוריות וביוץ -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}"
                                     Visibility="{Binding SettingsVm.ShowFertility, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="הגדרות פוריות וביוץ" Style="{StaticResource SectionTitleTextStyle}"/>

                                    <TextBlock Text="אורך שלב לוטאלי (11-16 יום, ברירת מחדל 14):" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <TextBlock Text="לנשים שעברו מעקב ביוץ רפואי ויודעות במדויק את מספר הימים מיום הביוץ ועד הדימום."
                                               Style="{StaticResource SectionCaptionTextStyle}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding SettingsVm.FertilityLutealPhaseDays, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsFieldStyle}" Width="92"
                                             HorizontalAlignment="Left" Margin="0,0,0,14"/>

                                    <TextBlock Text="בסיס חישוב המחזור:" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <RadioButton Content="חישוב אוטומטי לפי ממוצע ההפלגות האחרונות"
                                                 GroupName="CycleBasisGroup" Margin="0,0,0,5" FontSize="12.5"
                                                 IsChecked="{Binding SettingsVm.IsCycleBasisAuto, Mode=TwoWay}"/>
                                    <RadioButton Content="אורך מחזור קבוע ידני"
                                                 GroupName="CycleBasisGroup" Margin="0,0,0,8" FontSize="12.5"
                                                 IsChecked="{Binding SettingsVm.IsCycleBasisManual, Mode=TwoWay}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14"
                                                Visibility="{Binding SettingsVm.IsCycleBasisManual, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="אורך מחזור (ימים):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding SettingsVm.FertilityManualCycleDays, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldStyle}" Width="76"/>
                                    </StackPanel>

                                    <ui:ToggleSwitch Content="התרע כאשר הביוץ המשוער חל לפני ליל הטבילה"
                                                     IsChecked="{Binding SettingsVm.FertilityOvulationConflictAlert}"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- חומרות הלכתיות -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="חומרות הלכתיות (מחלוקות פוסקים)" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="כל מתג כאן הוא מחלוקת אמיתית בספר — ברירת המחדל היא השיטה הפשוטה, וההחמרה היא בחירה מודעת. ריחוף על מתג יציג את טעמו ומקורו."
                                               Style="{StaticResource SectionCaptionTextStyle}"/>

                                    <UniformGrid Columns="2" Margin="0,4,0,0">
                                        <ui:ToggleSwitch Content="ספק עונה — לחוש לשתי העונות"
                                                  ToolTip="כשראתה ספק סמוך לחילוף העונות — לחוש אף לעונה הקודמת, ולא לעונה המאוחרת בלבד."
                                                  IsChecked="{Binding SettingsVm.SafekOnaBoth}" Margin="0,0,14,12"/>
                                        <ui:ToggleSwitch Content="וסת הדילוג והסירוג — לחשב חשש"
                                                  ToolTip="כשהתבנית מוכחת — לחשב על פיה את יום החשש; אחרת מוצגת לבירור עם רב בלבד."
                                                  IsChecked="{Binding SettingsVm.Dilug}" Margin="0,0,0,12"/>
                                        <ui:ToggleSwitch Content="עקירת וסת שאינו קבוע — לדרוש בדיקה"
                                                  ToolTip="כרגע: עבר זמן הוסת ולא ראתה — נעקר מיד. במתג זה: אינו נעקר עד שתיבדק בדיקה כדין."
                                                  IsChecked="{Binding SettingsVm.CheckUprootNonFixed}" Margin="0,0,14,12"/>
                                        <ui:ToggleSwitch Content="עונת אור זרוע בליל יום הל&quot;א"
                                                  ToolTip="המנהג להוסיף עונת אור זרוע אף לפני עונה בינונית של יום הל&quot;א. מן הדין אין צריך, ולמעשה יש להחמיר."
                                                  IsChecked="{Binding SettingsVm.OrZaruaDay31}" Margin="0,0,0,12"/>
                                        <ui:ToggleSwitch Content="בדיקה באיחור — מועילה (דעת הב&quot;י)"
                                                  ToolTip="כשעבר זמן הוסת ולא נבדקה בו: כבוי = אינה מועילה, וצריך בדיקה בזמנה דווקא."
                                                  IsChecked="{Binding SettingsVm.LateBedika}" Margin="0,0,14,12"/>
                                        <ui:ToggleSwitch Content="מניין ההפלגה — מסוף הראייה"
                                                  ToolTip="כשהראייה נמשכה כמה ימים: מניין ברירת המחדל מתחילתה; במתג זה — מסופה."
                                                  IsChecked="{Binding SettingsVm.HaflagahFromEnd}" Margin="0,0,0,12"/>
                                        <ui:ToggleSwitch Content="פחד פתאום — לדרוש בדיקה"
                                                  ToolTip="דעת החת&quot;ס שאינה צריכה בדיקה, והגר&quot;ש קלוגר סובר שצריכה בדיקה. כבוי = כחת&quot;ס."
                                                  IsChecked="{Binding SettingsVm.FrightBedika}" Margin="0,0,14,12"/>
                                        <ui:ToggleSwitch Content="כתם — שנחשב עקירת הוסת"
                                                  ToolTip="כרגע: הכתם &quot;כמי שאינו לענין וסתות&quot;. במתג זה: כשערי טוהר — כתם שנמצא בזמן הוסת שלש פעמים נחשב עקירה."
                                                  IsChecked="{Binding SettingsVm.StainUproots}" Margin="0,0,0,12"/>
                                        <ui:ToggleSwitch Content="צירוף למפרע — הפלגה ארוכה על פני הפלגה אחרת"
                                                  ToolTip="כרגע: וסת ההפלגה נקבעת רק בג' הפלגות רצופות שוות. במתג זה: גם כשבאמצע ראתה בהפלגה קצרה, מצטרפת הווסת הארוכה."
                                                  IsChecked="{Binding SettingsVm.ChiburLemafrea}" Margin="0,0,14,12"/>
                                        <ui:ToggleSwitch Content="וסת הגוף שאינה קבועה — לדרוש בדיקה כשעבר הזמן"
                                                  ToolTip="דלוק (ברירת מחדל) = כדעת הט&quot;ז, אסורה עד שתבדוק. כבוי = כדעת הש&quot;ך, אין חומרא יתרה."
                                                  IsChecked="{Binding SettingsVm.VesetHagufBedika}" Margin="0,0,0,12"/>
                                        <ui:ToggleSwitch Content="כרתי ופלתי — עונה בינונית ליממה שלמה"
                                                  ToolTip="מנהג אשכנז: הרחבת עונת הפרישה של יום ל' ליממה שלמה — יום ולילה כאחד."
                                                  IsChecked="{Binding SettingsVm.KaretiUfaletei}" Margin="0,0,14,12"/>
                                        <ui:ToggleSwitch Content="וסת מעד בדיקה — דם שנמצא בבדיקה נמנה כראייה"
                                                  ToolTip="כרגע: וסת נקבע רק על ידי ראייה כדרכה. במתג זה: גם דם שנמצא בבדיקה (&quot;עד בדיקה&quot;) נמנה כראייה."
                                                  IsChecked="{Binding SettingsVm.VesetFromBedika}" Margin="0,0,0,12"/>
                                        <ui:ToggleSwitch Content="מאכל חריף — כוסת האונס (לא נספרת לחזקה לבדה)"
                                                  ToolTip="כרגע: ראייה מחמת מאכל חריף נספרת לחזקה כוסת הגוף. במתג זה: דינה כוסת האונס, ואינה קובעת וסת לבדה."
                                                  IsChecked="{Binding SettingsVm.SharpFoodOnes}" Margin="0,0,14,12"/>
                                        <ui:ToggleSwitch Content="ימי המבוכה — חומרת הרמ&quot;א"
                                                  ToolTip="מנהג אשכנז: שני ימים מתחלפים (ג' פעמים כל אחד) נחשבים וסת קבוע לשניהם. עדות המזרח אינם חוששים לכך כלל — מקושר ל'פרופיל מנהג' למעלה."
                                                  IsChecked="{Binding SettingsVm.MevuchaDays}" Margin="0,0,0,12"/>
                                    </UniformGrid>
                                </StackPanel>
                            </ui:Card>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== Tab: מיקום וזמנים ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Style="{StaticResource TabHeaderStackStyle}">
                            <TextBlock Text="מיקום וזמנים" Margin="0,0,9,0"/>
                            <ui:SymbolIcon Symbol="Location24"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="עיר וזמני היום (שקיעה ונץ)" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="לחישוב עונות היום והלילה, ולקביעת &quot;היום&quot; לפי שקיעה, ולבירור ספק עונה:"
                                               Style="{StaticResource SectionCaptionTextStyle}"/>

                                    <ComboBox ItemsSource="{Binding SettingsVm.AvailableCities}"
                                              DisplayMemberPath="Label" SelectedValuePath="Id"
                                              SelectedValue="{Binding SettingsVm.SelectedCityId, Mode=TwoWay}"
                                              Padding="6,5"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== Tab: אבטחה ונעילה ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Style="{StaticResource TabHeaderStackStyle}">
                            <TextBlock Text="אבטחה ונעילה" Margin="0,0,9,0"/>
                            <ui:SymbolIcon Symbol="ShieldCheckmark24"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="אבטחת המערכת וקוד PIN" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="הקוד נעל את האפליקציה בכל פתיחה, ומשמש גם כמפתח להצפנת קובץ בסיס הנתונים עצמו (AES-GCM)."
                                               Style="{StaticResource SectionCaptionTextStyle}"/>

                                    <StackPanel Visibility="{Binding SettingsVm.HasPin, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="הגדרת קוד חדש:" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBox Text="{Binding SettingsVm.NewPin, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldStyle}" Margin="0,0,0,8"/>
                                        <TextBlock Text="אימות קוד:" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBox Text="{Binding SettingsVm.ConfirmPin, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldStyle}" Margin="0,0,0,12"/>
                                        <ui:Button Content="שמור קוד PIN" Command="{Binding SettingsVm.UpdatePinCommand}"
                                                   Style="{StaticResource AppButtonStyle}" Appearance="Primary">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="LockClosed24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding SettingsVm.HasPin, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ShieldCheckmark24" Margin="0,0,9,0"
                                                               Foreground="{DynamicResource SuccessFgBrush}"/>
                                                <TextBlock Text="המערכת מוגנת בקוד PIN אישי, ובסיס הנתונים מוצפן"
                                                           FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{DynamicResource SuccessFgBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ui:Button Content="הסר הגנת PIN" Command="{Binding SettingsVm.RemovePinCommand}"
                                                   Style="{StaticResource AppButtonStyle}" Appearance="Danger"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SettingsVm.PinStatusMessage}" FontSize="11.5"
                                               Foreground="{DynamicResource WarningFgBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Visibility="{Binding SettingsVm.PinStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== Tab: גיבוי וסנכרון ==================== -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Style="{StaticResource TabHeaderStackStyle}">
                            <TextBlock Text="גיבוי וסנכרון" Margin="0,0,9,0"/>
                            <ui:SymbolIcon Symbol="Cloud24"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- גיבוי מקומי -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="גיבוי ושחזור מקומי (JSON)" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="שמירת קובץ גיבוי במחשב או שחזור מגיבוי קודם:"
                                               Style="{StaticResource SectionCaptionTextStyle}"/>

                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="ייצוא גיבוי לקובץ" Command="{Binding SettingsVm.ExportJsonBackupCommand}"
                                                   Style="{StaticResource AppButtonStyle}" Appearance="Secondary" Margin="0,0,8,0">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Save24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="שחזור מתוך קובץ" Command="{Binding SettingsVm.RestoreJsonBackupCommand}"
                                                   Style="{StaticResource AppButtonStyle}" Appearance="Secondary">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>

                            <!-- גוגל -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="גיבוי וסנכרון ענן (חשבון Google)" Style="{StaticResource SectionTitleTextStyle}"/>

                                    <StackPanel Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="חיבור חשבון Google מאפשר גיבוי לגיליון Sheets וסנכרון תזכורות ליומן ייעודי ונפרד."
                                                   Style="{StaticResource SectionCaptionTextStyle}"/>
                                        <ui:Button Content="התחבר לחשבון Google" Command="{Binding SettingsVm.ConnectGoogleCommand}"
                                                   Style="{StaticResource AppButtonStyle}" Appearance="Primary"
                                                   HorizontalAlignment="Left">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Link24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Checkmark24" Margin="0,0,9,0"
                                                               Foreground="{DynamicResource SuccessFgBrush}"/>
                                                <TextBlock FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SuccessFgBrush}">
                                                    <Run Text="מחובר:"/>
                                                    <Run Text="{Binding SettingsVm.GoogleEmail, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="מזהה גיליון Google Sheets:" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBox Text="{Binding SettingsVm.SheetId, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldStyle}" Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <ui:Button Content="פתח את הגיליון" Command="{Binding SettingsVm.OpenGoogleSheetCommand}"
                                                       Style="{StaticResource AppButtonStyle}" Appearance="Secondary" Margin="0,0,8,0">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="DataTrending24"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button Content="נתק חשבון" Command="{Binding SettingsVm.DisconnectGoogleCommand}"
                                                       Style="{StaticResource AppButtonStyle}" Appearance="Danger"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource DividerBorderStyle}"/>

                                        <TextBlock Text="כתובת אימייל לשחזור (מוצגת בגיבוי, לזיהוי בעתיד):" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <TextBox Text="{Binding SettingsVm.RecoveryEmail, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SettingsFieldStyle}" Width="240" Margin="0,0,8,0"/>
                                            <ui:Button Content="שמור" Command="{Binding SettingsVm.SaveRecoveryEmailCommand}"
                                                       Style="{StaticResource AppButtonStyle}" Appearance="Secondary"/>
                                        </StackPanel>

                                        <TextBlock Text="הגיבוי לגיליון Sheets אינו אוטומטי בגרסה זו — יש להריץ אותו ידנית, ולשחזר (מיזוג בלבד, בלי למחוק נתונים מקומיים) בעת הצורך:"
                                                   Style="{StaticResource SectionCaptionTextStyle}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="גבה עכשיו לגוגל" Command="{Binding SettingsVm.BackupToGoogleNowCommand}"
                                                       Style="{StaticResource AppButtonStyle}" Appearance="Secondary" Margin="0,0,8,0">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Cloud24"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button Content="שחזר ומזג מגוגל" Command="{Binding SettingsVm.RestoreFromGoogleMergeCommand}"
                                                       Style="{StaticResource AppButtonStyle}" Appearance="Secondary">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowDownload24"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SettingsVm.GoogleBackupStatusMessage}" TextWrapping="Wrap"
                                                   Style="{StaticResource StatusMessageTextStyle}"
                                                   Visibility="{Binding SettingsVm.GoogleBackupStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SettingsVm.GoogleStatusMessage}" TextWrapping="Wrap"
                                               Style="{StaticResource StatusMessageTextStyle}"
                                               Visibility="{Binding SettingsVm.GoogleStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding SettingsVm.SyncStatusMessage}" TextWrapping="Wrap"
                                               Style="{StaticResource StatusMessageTextStyle}" Margin="0,4,0,0"
                                               Visibility="{Binding SettingsVm.SyncStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- יומן גוגל -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}"
                                     Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="יומן גוגל והתראות דוא&quot;ל" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="סנכרון תזכורות בדיקות וימי פרישה ליומן ייעודי ונפרד ביומן Google — היומן הראשי שלך לעולם אינו נגע."
                                               Style="{StaticResource SectionCaptionTextStyle}"/>

                                    <ui:ToggleSwitch Content="הפעל סנכרון ליומן גוגל"
                                                     IsChecked="{Binding SettingsVm.CalendarSyncEnabled}" Margin="0,0,0,14"/>

                                    <StackPanel Visibility="{Binding SettingsVm.CalendarSyncEnabled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="רמת דיסקרטיות בשם האירוע:" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <ComboBox ItemsSource="{Binding SettingsVm.CalendarDiscretionOptions}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SettingsVm.CalendarDiscretion, Mode=TwoWay}"
                                                  Padding="6,5" Margin="0,0,0,10"/>

                                        <StackPanel Visibility="{Binding SettingsVm.CalendarDiscretion, Converter={StaticResource StringEqualsToVis}, ConverterParameter=discreet}">
                                            <TextBlock Text="קידומת מותאמת אישית (למשל: פגישה):" Style="{StaticResource FieldLabelTextStyle}"/>
                                            <TextBox Text="{Binding SettingsVm.CalendarDiscreetPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SettingsFieldStyle}" Margin="0,0,0,10"/>
                                        </StackPanel>

                                        <ui:ToggleSwitch Content="שלח התראות בדוא&quot;ל"
                                                         IsChecked="{Binding SettingsVm.CalendarNotifyEmail}" Margin="0,0,0,10"/>
                                        <ui:ToggleSwitch Content="הצג התראות פופ-אפ ביומן"
                                                         IsChecked="{Binding SettingsVm.CalendarNotifyPopup}" Margin="0,0,0,14"/>

                                        <TextBlock Text="שעת בדיקת בוקר (HH:MM):" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <TextBox Text="{Binding SettingsVm.CalendarMorningTime, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SettingsFieldStyle}" Width="110" HorizontalAlignment="Left"
                                                 Margin="0,0,0,12"/>

                                        <TextBlock Text="זמן תזכורת דוא&quot;ל לפני השקיעה (בדקות):" Style="{StaticResource FieldLabelTextStyle}"/>
                                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SettingsVm.CalendarSunsetLeadMinutes, Mode=TwoWay}"
                                                  Padding="6,5" Margin="0,0,0,12">
                                            <ComboBoxItem Content="30" Tag="30"/>
                                            <ComboBoxItem Content="45" Tag="45"/>
                                            <ComboBoxItem Content="60" Tag="60"/>
                                            <ComboBoxItem Content="120" Tag="120"/>
                                        </ComboBox>

                                        <ui:ToggleSwitch Content="תזכורת בדיקת מוך דחוק"
                                                         IsChecked="{Binding SettingsVm.CalendarMochDachukEnabled}" Margin="0,0,0,14"/>

                                        <Border Style="{StaticResource InlineAlertBorderStyle}"
                                                Visibility="{Binding SettingsVm.CalendarHasScope, Converter={StaticResource InvBoolToVis}}">
                                            <TextBlock Text="שים לב: החיבור הקיים לא בהכרח כולל הרשאת יומן — אם הסנכרון נכשל, נתק וחבר מחדש את החשבון."
                                                       FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource WarningStrongFgBrush}"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <ui:Button Content="סנכרן כעת" Command="{Binding SettingsVm.SyncCalendarNowCommand}"
                                                       Style="{StaticResource AppButtonStyle}" Appearance="Primary" Margin="0,0,8,0">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowSync24"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button Content="פתח את יומן גוגל" Command="{Binding SettingsVm.OpenGoogleCalendarCommand}"
                                                       Style="{StaticResource AppButtonStyle}" Appearance="Secondary" Margin="0,0,8,0">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Calendar24"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button Content="נקה תזכורות" Command="{Binding SettingsVm.ClearCalendarEventsCommand}"
                                                       Style="{StaticResource AppButtonStyle}" Appearance="Danger"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding SettingsVm.CalendarLastSyncMessage}"
                                                   Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SettingsVm.CalendarStatusMessage}" TextWrapping="Wrap"
                                               Style="{StaticResource StatusMessageTextStyle}" Margin="0,6,0,0"
                                               Visibility="{Binding SettingsVm.CalendarStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- יומן תקלות -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="יומן תקלות לתמיכה" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Style="{StaticResource SectionCaptionTextStyle}">
                                        <Run Text="נרשמו"/>
                                        <Run Text="{Binding SettingsVm.ErrorLogCount, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text="תקלות. ייצוא הקובץ ושליחתו לתמיכה עוזר לאבחן בעיה מרחוק."/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="ייצוא יומן תקלות" Command="{Binding SettingsVm.ExportErrorLogCommand}"
                                                   Style="{StaticResource AppButtonStyle}" Appearance="Secondary" Margin="0,0,8,0">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="DocumentBulletList24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="נקה יומן" Command="{Binding SettingsVm.ClearErrorLogCommand}"
                                                   Style="{StaticResource AppButtonStyle}" Appearance="Danger">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>

                            <!-- ייצוא במייל -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="ייצוא נתונים בדוא&quot;ל" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="שליחת ריכוז נתוני הלוח לכתובת דוא&quot;ל שתבחר/י — למשל כדי לשתף עם רב או לשמור עותק חיצוני."
                                               Style="{StaticResource SectionCaptionTextStyle}"/>

                                    <TextBlock Text="כתובת דוא&quot;ל לשליחה:" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <TextBox Text="{Binding SettingsVm.ExportEmail, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsFieldStyle}" Margin="0,0,0,12"/>

                                    <TextBlock Text="הודעה (אופציונלי):" Style="{StaticResource FieldLabelTextStyle}"/>
                                    <TextBox Text="{Binding SettingsVm.ExportNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SettingsFieldStyle}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="54" Margin="0,0,0,12"/>

                                    <ui:ToggleSwitch Content="נתוני פרישה עתידיים (וסתות, חששות, בדיקות ממתינות)"
                                                     IsChecked="{Binding SettingsVm.ExportIncludeFuture}" Margin="0,0,0,10"/>
                                    <ui:ToggleSwitch Content="היסטוריית אירועים מלאה"
                                                     IsChecked="{Binding SettingsVm.ExportIncludeHistory}" Margin="0,0,0,10"/>
                                    <ui:ToggleSwitch Content="כלול הערות אישיות שנרשמו על אירועים"
                                                     IsChecked="{Binding SettingsVm.ExportIncludeNotes}" Margin="0,0,0,14"/>

                                    <ui:Button Content="שלח נתונים בדוא&quot;ל" Command="{Binding SettingsVm.SendEmailExportCommand}"
                                               Style="{StaticResource AppButtonStyle}" Appearance="Primary"
                                               HorizontalAlignment="Left">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Mail24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <TextBlock Text="{Binding SettingsVm.ExportStatusMessage}" TextWrapping="Wrap"
                                               Style="{StaticResource StatusMessageTextStyle}"
                                               Visibility="{Binding SettingsVm.ExportStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ui:Card>

                            <!-- עדכונים -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="עדכוני תוכנה" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock Text="{Binding SettingsVm.CurrentVersionDisplay, StringFormat='גרסה נוכחית: v{0}'}"
                                               Style="{StaticResource SectionCaptionTextStyle}"/>
                                    <ui:Button Content="בדוק עדכונים ב-GitHub" Command="{Binding SettingsVm.CheckUpdatesCommand}"
                                               Style="{StaticResource AppButtonStyle}" Appearance="Secondary"
                                               HorizontalAlignment="Left">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowSync24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <TextBlock Text="{Binding SettingsVm.UpdateStatusMessage}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SuccessFgBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Visibility="{Binding SettingsVm.UpdateStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                                    <ui:Button Content="הורד את הגרסה החדשה" Command="{Binding SettingsVm.OpenReleaseUrlCommand}"
                                               Style="{StaticResource AppButtonStyle}" Appearance="Primary"
                                               Margin="0,10,0,0" HorizontalAlignment="Left"
                                               Visibility="{Binding SettingsVm.LatestReleaseUrl.Length, Converter={StaticResource BoolToVis}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowDownload24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </ui:Card>

                            <!-- אזור מסוכן -->
                            <ui:Card Style="{StaticResource AppSectionCardStyle}" BorderBrush="{DynamicResource DangerBorderBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,8,0" Foreground="{DynamicResource DangerFgBrush}"/>
                                        <TextBlock Text="מחיקת כל הנתונים" Style="{StaticResource SubtitleTextStyle}"
                                                   Foreground="{DynamicResource DangerFgBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="מוחק לצמיתות את כל האירועים, קוד ה-PIN וכל ההגדרות (מנהג, פוריות, מתגי חומרא, יומן וגיבוי ענן). פעולה זו אינה הפיכה."
                                               Style="{StaticResource SectionCaptionTextStyle}"/>

                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Command="{Binding SettingsVm.DeleteAllDataCommand}" Margin="0,0,8,0">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource AppButtonStyle}">
                                                    <Setter Property="Appearance" Value="Danger"/>
                                                    <Setter Property="Content" Value="מחק את כל הנתונים"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SettingsVm.DeleteAllArmed}" Value="True">
                                                            <Setter Property="Content" Value="לחץ שוב לאישור מחיקה סופית"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Content="ביטול" Command="{Binding SettingsVm.CancelDeleteAllDataCommand}"
                                                   Style="{StaticResource AppButtonStyle}" Appearance="Secondary"
                                                   Visibility="{Binding SettingsVm.DeleteAllArmed, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding SettingsVm.DeleteAllStatusMessage}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DangerFgBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Visibility="{Binding SettingsVm.DeleteAllStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ui:Card>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- ==================== Sticky footer ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="0,14,0,14" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Content="שמור שינויים וסגור"
                               Command="{Binding SettingsVm.SaveSettingsCommand}"
                               Style="{StaticResource PrimaryButtonStyle}" Padding="16,10"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <ui:Button Grid.Column="1" Content="ביטול"
                               Command="{Binding CloseSettingsCommand}"
                               Click="OnCloseSettingsClicked"
                               Style="{StaticResource AppButtonStyle}" Appearance="Secondary"
                               Padding="24,10" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </ui:Card>
</UserControl>
