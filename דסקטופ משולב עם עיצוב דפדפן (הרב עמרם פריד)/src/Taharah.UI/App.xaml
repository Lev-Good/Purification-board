<Application x:Class="Taharah.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Taharah.UI"
             xmlns:uimkp="clr-namespace:Wpf.Ui.Markup;assembly=Wpf.Ui">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI's own Fluent control templates + theme brushes (ApplicationBackgroundBrush,
                     TextFillColorPrimaryBrush, CardBackgroundFillColorDefaultBrush, Focus*Brush, etc.) -
                     required by every ui:* control used across the app (FluentWindow, Card, Button,
                     ToggleSwitch, SymbolIcon...). ApplicationThemeManager.Apply (called from
                     ThemeService.Apply) keeps ThemesDictionary's active theme in sync with our own
                     Light/DarkTheme.xaml swap below, so both brush sets always agree on light vs dark. -->
                <uimkp:ThemesDictionary Theme="Light" />
                <uimkp:ControlsDictionary />
                <!-- The design system: typography scale, spacing and the app's own control/card/badge
                     styles. It carries NO colors of its own - every color it uses is a DynamicResource
                     semantic token defined by the two theme files below (see Themes/DesignSystem.xaml). -->
                <ResourceDictionary Source="Themes/DesignSystem.xaml"/>
                <!-- Semantic color tokens (one file per theme; swapped at runtime by ThemeService). -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
