<ui:FluentWindow x:Class="Taharah.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Taharah.UI.Converters"
        xmlns:views="clr-namespace:Taharah.UI.Views"
        xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
        mc:Ignorable="d"
        Title="לוח טהרה — מערכת הלכתית מקצועית"
        Height="880" Width="1340"
        MinHeight="700" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable Text, Segoe UI, Arial Hebrew, Tahoma, Arial"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        KeyDown="OnWindowKeyDown">

    <ui:FluentWindow.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>

        <!-- כותרת יום בשבוע בשורת הראש -->
        <Style x:Key="WeekdayHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AppContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
        </Style>

        <Style x:Key="AppMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ==================== משבצת יום בלוח החודשי ====================
             Border ולא ui:Card: למשבצת יש פינות מעוגלות בעצמה, רצועת סטטוס
             צבעונית בקצה, ורקעים שונים למצב נבחר/היום - ו-Border נותן שליטה
             מלאה על כולם בלי תלות בתבנית הפנימית של כרטיס Fluent.
             סדר העדיפויות של רצועת הסטטוס זהה לזה של DetermineDayStatus:
             ראייה > הפסק טהרה > טבילה > בדיקה. -->
        <Style x:Key="DayTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DayTileBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DayTileBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DayTileHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Opacity" Value="0.42"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource TodayRingBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedTintBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SelectedRingBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- רצועת הסטטוס בקצה המשבצת -->
        <Style x:Key="DayAccentBarStyle" TargetType="Border">
            <Setter Property="Width" Value="3"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasReiya}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SightingFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHefsekTaharah}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HefsekFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMikvehNight}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MikvehFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCheck}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CheckFgBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <!-- Main Layout (TitleBar + Toolbar + Alerts + Calendar Grid + Day Drawer) -->
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>   <!-- Win11 TitleBar -->
                <RowDefinition Height="72"/>   <!-- Toolbar: 3 zones -->
                <RowDefinition Height="Auto"/> <!-- Day State Alerts -->
                <RowDefinition Height="34"/>   <!-- Weekday header -->
                <RowDefinition Height="*"/>    <!-- Calendar + Day drawer -->
            </Grid.RowDefinitions>

            <!-- ==================== 0. TitleBar ==================== -->
            <ui:TitleBar Grid.Row="0" Title="לוח טהרה — הלכות טהרה (הרב עמרם פריד)">
                <ui:TitleBar.Icon>
                    <ui:SymbolIcon Symbol="CalendarLtr24"/>
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <!-- ==================== 1. Toolbar (3 zones) ==================== -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="18,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Zone 1 (start/right): brand + month -->
                        <ColumnDefinition Width="*"/>    <!-- Zone 2 (center): month nav + view switcher -->
                        <ColumnDefinition Width="Auto"/> <!-- Zone 3 (end/left): tools + system -->
                    </Grid.ColumnDefinitions>

                    <!-- Zone 1: Brand & current month -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0"
                                Background="{DynamicResource PrimaryBrush}">
                            <TextBlock Text="ט" FontSize="21" FontWeight="Bold"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentHebrewMonthName}" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMainBrush}"/>
                                <TextBlock Text=" " FontSize="19"/>
                                <TextBlock Text="{Binding CurrentHebrewYearFormatted}" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentGregorianHeader}" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Zone 2: Month navigation + Month/Year segmented control -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- RTL: the right-most button moves back in time -->
                        <ui:Button Command="{Binding PreviousMonthCommand}" Style="{StaticResource IconButtonStyle}"
                                   ToolTip="חודש קודם (זמן אחורה)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ChevronRight24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="היום" Command="{Binding GoToTodayCommand}"
                                   Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,8,0"
                                   ToolTip="עבור לחודש הנוכחי"/>
                        <ui:Button Command="{Binding NextMonthCommand}" Style="{StaticResource IconButtonStyle}"
                                   ToolTip="חודש הבא (זמן קדימה)">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ChevronLeft24"/>
                            </ui:Button.Icon>
                        </ui:Button>

                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="3"
                                Margin="14,0,0,0" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Command="{Binding ToggleYearlyViewCommand}" Padding="12,5" Margin="0,0,2,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="CalendarLtr24"/>
                                    </ui:Button.Icon>
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource AppButtonStyle}">
                                            <Setter Property="Appearance" Value="Secondary"/>
                                            <Setter Property="Content" Value="חודש"/>
                                            <Setter Property="Margin" Value="0,0,2,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsYearlyView}" Value="False">
                                                    <Setter Property="Appearance" Value="Primary"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Command="{Binding ToggleYearlyViewCommand}" Padding="12,5">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="CalendarMonth24"/>
                                    </ui:Button.Icon>
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource AppButtonStyle}">
                                            <Setter Property="Appearance" Value="Secondary"/>
                                            <Setter Property="Content" Value="שנה"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsYearlyView}" Value="True">
                                                    <Setter Property="Appearance" Value="Primary"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Zone 3: Halachic tools | system controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="ריכוז וסתות" Command="{Binding OpenVesetSummaryCommand}"
                                   Style="{StaticResource ToolbarButtonStyle}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DataTrending24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="מדריך" Command="{Binding OpenGuideCommand}"
                                   Style="{StaticResource ToolbarButtonStyle}" ToolTip="מדריך הלכתי ומאגר מקורות">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="BookOpen24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="תובנות" Command="{Binding OpenInsightsCommand}"
                                   Style="{StaticResource ToolbarButtonStyle}" ToolTip="תובנות מחזור וחלון פוריות">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="HeartPulse24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="דוח והדפסה" Command="{Binding PrintReportCommand}"
                                   Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Print24"/>
                            </ui:Button.Icon>
                        </ui:Button>

                        <Border Width="1" Height="26" Background="{DynamicResource AppBorderBrush}" Margin="4,0,10,0"/>

                        <ui:Button Content="{Binding ZoomLabel}" Style="{StaticResource ToolbarButtonStyle}"
                                   Click="OnMoreMenuClick" ToolTip="הגדל / הקטן תצוגה">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ZoomIn24"/>
                            </ui:Button.Icon>
                            <ui:Button.ContextMenu>
                                <ContextMenu Style="{StaticResource AppContextMenuStyle}" Placement="Bottom"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="הגדל תצוגה" Command="{Binding ZoomInCommand}" Style="{StaticResource AppMenuItemStyle}"/>
                                    <MenuItem Header="הקטן תצוגה" Command="{Binding ZoomOutCommand}" Style="{StaticResource AppMenuItemStyle}"/>
                                    <Separator/>
                                    <MenuItem Header="אפס ל-100%" Command="{Binding ZoomResetCommand}" Style="{StaticResource AppMenuItemStyle}"/>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>

                        <ui:Button Command="{Binding OpenAboutCommand}" Style="{StaticResource IconButtonStyle}"
                                   ToolTip="אודות והוראות שימוש">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Info24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource IconButtonStyle}"
                                   ToolTip="הגדרות מערכת והלכה" Margin="6,0,0,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Settings24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding LockAppCommand}" Style="{StaticResource IconButtonStyle}"
                                   ToolTip="נעל את הלוח" Margin="6,0,0,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="LockClosed24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Command="{Binding ToggleThemeCommand}" Margin="6,0,0,0" ToolTip="החלף מצב יום/לילה">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Content" Value="{Binding ThemeIcon}"/>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== 2. Day State Alerts ====================
                 העיקרון המתועד (DECISIONS 2026-09-18): מסקנה הלכתית אינה מוסתרת
                 מאחורי קליק. שלושת סוגי ההודעות כאן תמיד גלויים כשקיימים. -->
            <Border Grid.Row="2" Style="{StaticResource AlertPanelBorderStyle}"
                    Visibility="{Binding HasDayStatePanel, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                Visibility="{Binding HasOpenFright, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Alert24" FontSize="15" Margin="0,0,7,0"
                                       Foreground="{DynamicResource DangerFgBrush}"/>
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource WarningStrongFgBrush}">
                            <Run Text="פחד פתאום (ביעתותא) — טרם נברר: " FontWeight="Bold"/>
                            <Run Text="{Binding OpenFrightText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding OrZaruaExemptionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Margin="0,0,7,0"
                                                   Foreground="{DynamicResource SuccessFgBrush}"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource WarningStrongFgBrush}" TextWrapping="Wrap">
                                        <Run Text="עונת אור זרוע שנפטרה: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding Text, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding HasAnxiety, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="0,0,7,0"
                                       Foreground="{DynamicResource WarningFgBrush}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource WarningStrongFgBrush}" TextWrapping="Wrap">
                            <Run Text="חרדה מתמשכת: " FontWeight="SemiBold"/>
                            <Run Text="{Binding AnxietyText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 3. Weekday header ====================
                 הכותרת מיושרת לעמודות הלוח ולא לרוחב החלון: כשמגירת היום פתוחה הלוח
                 מתחיל רק אחרי המגירה, ולכן כותרת שנמתחת על כל החלון יושבת מעל המגירה
                 במקום מעל משבצות הימים. כאן היא בנויה באותן שתי עמודות של שורת התוכן
                 (לוח + מגירה) - עם אלמנט ריווח בגודל המגירה כשזו פתוחה.
                 הרוחב 416 זהה לרוחב המגירה שלמטה; שינוי אחד מחייב את השני. -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="6,0,6,0" Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsYearlyView, Converter={StaticResource InvBoolToVis}}">
                    <UniformGrid Columns="7">
                        <TextBlock Text="יום ראשון" Style="{StaticResource WeekdayHeaderStyle}"/>
                        <TextBlock Text="יום שני" Style="{StaticResource WeekdayHeaderStyle}"/>
                        <TextBlock Text="יום שלישי" Style="{StaticResource WeekdayHeaderStyle}"/>
                        <TextBlock Text="יום רביעי" Style="{StaticResource WeekdayHeaderStyle}"/>
                        <TextBlock Text="יום חמישי" Style="{StaticResource WeekdayHeaderStyle}"/>
                        <TextBlock Text="יום שישי" Style="{StaticResource WeekdayHeaderStyle}"/>
                        <TextBlock Text="שבת קודש" Style="{StaticResource WeekdayHeaderStyle}"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </UniformGrid>
                </Border>

                <!-- ריווח בגודל המגירה: רק כשהיא פתוחה -->
                <Border Grid.Column="1" Width="416" Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- ==================== 4. Calendar + Day drawer ==================== -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/> <!-- Day action drawer -->
                </Grid.ColumnDefinitions>

                <!-- 7x6 Month Grid. PreviewMouseLeftButtonUp (ולא MouseLeftButtonUp) כדי שהלחיצה
                     תיתפס לפני שתגיות פנימיות בולעות את האירוע. -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding CalendarDays}" Margin="6,6,6,8"
                              Visibility="{Binding IsYearlyView, Converter={StaticResource InvBoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DayTileStyle}" PreviewMouseLeftButtonUp="OnDayCardClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- רצועת סטטוס בקצה -->
                                    <Border Grid.Column="1" Style="{StaticResource DayAccentBarStyle}" Margin="0,0,-5,0"/>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header: Hebrew day + Gregorian day + sunset -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding HebrewDayString}" FontSize="15" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMainBrush}"/>
                                                <TextBlock Text="{Binding DayNumber, StringFormat=' ({0})'}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Sunset, StringFormat='שק׳ {0}'}"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Badges -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Badges}" Margin="0,4,0,2">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ui:Badge Style="{StaticResource CategoryBadgeStyle}"
                                                              Content="{Binding Text}"
                                                              ToolTip="{Binding Tooltip}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Status summary -->
                                        <TextBlock Grid.Row="2" Text="{Binding StatusSummary}" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Yearly overview: 12 weekday-aligned mini-months -->
                <ScrollViewer Grid.Column="0" Margin="10,10,10,12" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsYearlyView, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding YearlyMonths}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Style="{StaticResource AppCardStyle}" Padding="12" Margin="0,0,10,10" Width="286">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MonthLabel}" FontSize="13.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"
                                                   HorizontalAlignment="Center"/>

                                        <!-- Weekday letters: same right-to-left order as the monthly grid -->
                                        <UniformGrid Columns="7" Margin="0,0,0,4">
                                            <TextBlock Text="א" Style="{StaticResource WeekdayHeaderStyle}" FontSize="10"/>
                                            <TextBlock Text="ב" Style="{StaticResource WeekdayHeaderStyle}" FontSize="10"/>
                                            <TextBlock Text="ג" Style="{StaticResource WeekdayHeaderStyle}" FontSize="10"/>
                                            <TextBlock Text="ד" Style="{StaticResource WeekdayHeaderStyle}" FontSize="10"/>
                                            <TextBlock Text="ה" Style="{StaticResource WeekdayHeaderStyle}" FontSize="10"/>
                                            <TextBlock Text="ו" Style="{StaticResource WeekdayHeaderStyle}" FontSize="10"/>
                                            <TextBlock Text="ש" Style="{StaticResource WeekdayHeaderStyle}" FontSize="10"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                        </UniformGrid>

                                        <ItemsControl ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="36" Height="36" Margin="1" CornerRadius="8" Cursor="Hand"
                                                            ToolTip="{Binding StatusSummary}"
                                                            PreviewMouseLeftButtonUp="OnDayCardClicked">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource DayTileBgBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DayTileBorderBrush}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasReiya}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SightingBgBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SightingFgBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsHefsekTaharah}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource HefsekBgBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource HefsekFgBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsMikvehNight}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource MikvehBgBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource MikvehFgBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsShevaNekiyimDay}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource NekiimBgBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource TodayRingBrush}"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding HebrewDayString}" FontSize="11"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextMainBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Day action drawer -->
                <Border Grid.Column="1" Width="416" Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
                    <views:FlyoutDrawerView DataContext="{Binding}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== Overlays (slide-out drawers) ==================== -->
        <!-- Veset Summary -->
        <Border Visibility="{Binding IsVesetSummaryOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ScrimBrush}"
                PreviewMouseDown="OnOverlayBackgroundMouseDown">
            <Border HorizontalAlignment="Left" Width="880" Background="{DynamicResource SurfaceBrush}">
                <views:VesetSummaryDrawerView DataContext="{Binding}"/>
            </Border>
        </Border>

        <!-- About -->
        <Border Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ScrimBrush}"
                PreviewMouseDown="OnOverlayBackgroundMouseDown">
            <Border HorizontalAlignment="Left" Width="540" Background="{DynamicResource SurfaceBrush}">
                <views:AboutDrawerView DataContext="{Binding}"/>
            </Border>
        </Border>

        <!-- Halachic guide -->
        <Border Visibility="{Binding IsGuideOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ScrimBrush}"
                PreviewMouseDown="OnOverlayBackgroundMouseDown">
            <Border HorizontalAlignment="Left" Width="620" Background="{DynamicResource SurfaceBrush}">
                <views:GuideDrawerView DataContext="{Binding}"/>
            </Border>
        </Border>

        <!-- Cycle insights -->
        <Border Visibility="{Binding IsInsightsOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ScrimBrush}"
                PreviewMouseDown="OnOverlayBackgroundMouseDown">
            <Border HorizontalAlignment="Left" Width="540" Background="{DynamicResource SurfaceBrush}">
                <views:InsightsDrawerView DataContext="{Binding}"/>
            </Border>
        </Border>

        <!-- Settings -->
        <Border Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ScrimBrush}"
                PreviewMouseDown="OnOverlayBackgroundMouseDown">
            <Border HorizontalAlignment="Left" Width="900" Background="{DynamicResource SurfaceBrush}">
                <views:SettingsDrawerView DataContext="{Binding}"/>
            </Border>
        </Border>

        <!-- PIN lock screen -->
        <views:PinLockOverlayView Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                                  DataContext="{Binding}"/>

        <!-- Toast notifications -->
        <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                              HorizontalAlignment="Center" VerticalAlignment="Bottom"
                              Margin="0,0,0,24"/>
    </Grid>
</ui:FluentWindow>
