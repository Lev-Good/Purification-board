@namespace Taharah.Web.Shared.Components
@inject Taharah.Web.Shared.Services.CalendarStateService State
@implements IDisposable

<div class="view-container active">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
    <div>
      <h2 style="font-size: 22px; font-weight: 800; letter-spacing: -0.3px; margin: 0 0 6px 0;">תובנות מחזור, פוריות וסטטיסטיקה</h2>
      <p style="font-size: 13.5px; color: var(--text-muted); margin: 0;">ניתוח סטטיסטי הלכתי על בסיס הראיות שתוֹעדו בלוח</p>
    </div>
    <div style="background: var(--bg-surface-subtle); padding: 6px 14px; border-radius: var(--radius-pill); font-size: 12.5px; font-weight: 600; color: var(--text-secondary); border: 1px solid var(--border-subtle);">
      מתועדים @Report.TotalRecordedCycles מחזורים
    </div>
  </div>

  @if (Report.TotalRecordedCycles == 0)
  {
    <div style="background: var(--bg-surface); border: 1px dashed var(--border-subtle); border-radius: var(--radius-lg); padding: 40px 20px; text-align: center; margin-bottom: 24px;">
      <div style="width: 52px; height: 52px; margin: 0 auto 16px; border-radius: 50%; background: var(--bg-surface-subtle); display: flex; align-items: center; justify-content: center;">
        <SvgIcon Name="cycle" Size="28" />
      </div>
      <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 6px;">טרם תועדו מספיק ראיות</h3>
      <p style="font-size: 13.5px; color: var(--text-muted); max-width: 480px; margin: 0 auto;">
        הוסיפי ראיות נוספות בלוח השנה כדי לאפשר לאלגוריתם לחשב ממוצעים, חציון מחזור, חלונות ביוץ וגרף מגמות.
      </p>
    </div>
  }
  else
  {
    <!-- Stat Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 24px;">
      <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 18px; box-shadow: var(--shadow-sm);">
        <div style="font-size: 12px; color: var(--text-muted); font-weight: 600; margin-bottom: 6px;">ממוצע אורך מחזור</div>
        <div style="font-size: 26px; font-weight: 800; color: var(--primary);">@Report.AverageCycleLengthDays.ToString("0.0") <span style="font-size: 14px; font-weight: 500; color: var(--text-secondary);">ימים</span></div>
        <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px;">חציון: @Report.MedianCycleLengthDays.ToString("0.0") ימים</div>
      </div>

      <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 18px; box-shadow: var(--shadow-sm);">
        <div style="font-size: 12px; color: var(--text-muted); font-weight: 600; margin-bottom: 6px;">טווח מחזורים</div>
        <div style="font-size: 26px; font-weight: 800; color: var(--text-primary);">@Report.ShortestCycleDays - @Report.LongestCycleDays <span style="font-size: 14px; font-weight: 500; color: var(--text-secondary);">ימים</span></div>
        <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px;">קצר ביותר לעומת ארוך ביותר</div>
      </div>

      <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 18px; box-shadow: var(--shadow-sm);">
        <div style="font-size: 12px; color: var(--text-muted); font-weight: 600; margin-bottom: 6px;">ביוץ משוער הבא</div>
        <div style="font-size: 20px; font-weight: 800; color: var(--accent-sage);">
          @if (Report.EstimatedOvulationAbs.HasValue)
          {
            var h = new Taharah.Core.Calendar.HDate(Report.EstimatedOvulationAbs.Value);
            <span>@Taharah.Core.Calendar.HDate.ToGematriya(h.Day) @h.GetMonthName()</span>
          }
          else
          {
            <span>—</span>
          }
        </div>
        <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px;">
          @if (Report.EstimatedOvulationAbs.HasValue)
          {
            var greg = new DateTime(1, 1, 1).AddDays(Report.EstimatedOvulationAbs.Value - 1);
            <span>(@greg.ToString("dd/MM/yyyy"))</span>
          }
        </div>
      </div>

      <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 18px; box-shadow: var(--shadow-sm);">
        <div style="font-size: 12px; color: var(--text-muted); font-weight: 600; margin-bottom: 6px;">ראייה צפויה הבאה</div>
        <div style="font-size: 20px; font-weight: 800; color: var(--accent-cycle);">
          @if (Report.EstimatedNextReiyahAbs.HasValue)
          {
            var h = new Taharah.Core.Calendar.HDate(Report.EstimatedNextReiyahAbs.Value);
            <span>@Taharah.Core.Calendar.HDate.ToGematriya(h.Day) @h.GetMonthName()</span>
          }
          else
          {
            <span>—</span>
          }
        </div>
        <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px;">
          @if (Report.EstimatedNextReiyahAbs.HasValue)
          {
            var greg = new DateTime(1, 1, 1).AddDays(Report.EstimatedNextReiyahAbs.Value - 1);
            <span>(@greg.ToString("dd/MM/yyyy"))</span>
          }
        </div>
      </div>
    </div>

    <!-- Halachic Infertility Alert if applicable -->
    @if (Report.IsHalachicInfertilityRisk)
    {
      <div style="background: #fdf2f2; border: 1px solid #f8b4b4; border-radius: var(--radius-md); padding: 18px; margin-bottom: 24px; display: flex; gap: 14px; align-items: flex-start;">
        <div style="color: #991b1b; padding-top: 2px;">
          <SvgIcon Name="sign" Size="24" />
        </div>
        <div>
          <h4 style="font-size: 15px; font-weight: 700; color: #991b1b; margin: 0 0 4px 0;">חשש לעקרות הלכתית (ביוץ טרם טבילה)</h4>
          <p style="font-size: 13px; color: #7f1d1d; line-height: 1.5; margin: 0 0 8px 0;">
            לפי הנתונים, תאריך הביוץ המשוער חל לפני ליל הטבילה הצפוי. מצב זה שכיח וניתן לפיתרון הלכתי ורפואי פשוט ביותר (כגון הקדמת בדיקות באישור רב או ייעוץ רופא).
          </p>
          <div style="font-size: 12.5px; font-weight: 600; color: #991b1b;">
            מומלץ לפנות למורה הוראה מומחה או למכון פוע״ה / בוני עולם.
          </div>
        </div>
      </div>
    }

    <!-- Fertile Window & Mikveh Timeline Card -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 22px; margin-bottom: 24px; box-shadow: var(--shadow-sm);">
      <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        <SvgIcon Name="leaf" Size="20" />
        חלון פוריות משוער ומועד טבילה
      </h3>
      <p style="font-size: 13.5px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 18px;">
        חישוב חלון הפוריות מתבסס על שלב לוטאלי של 14 יום. הימים הפוריים הם 5 ימים טרם הביוץ ויום הביוץ עצמו.
      </p>

      <div style="display: flex; gap: 16px; flex-wrap: wrap;">
        @if (Report.FertileWindowStartAbs.HasValue && Report.FertileWindowEndAbs.HasValue)
        {
          var startH = new Taharah.Core.Calendar.HDate(Report.FertileWindowStartAbs.Value);
          var endH = new Taharah.Core.Calendar.HDate(Report.FertileWindowEndAbs.Value);
          var startGreg = new DateTime(1, 1, 1).AddDays(Report.FertileWindowStartAbs.Value - 1);
          var endGreg = new DateTime(1, 1, 1).AddDays(Report.FertileWindowEndAbs.Value - 1);

          <div style="flex: 1; min-width: 240px; background: var(--bg-surface-subtle); border-radius: var(--radius-md); padding: 14px; border: 1px solid var(--border-subtle);">
            <div style="font-size: 12px; font-weight: 700; color: var(--accent-sage); margin-bottom: 4px;">טווח חלון הפוריות המשוער</div>
            <div style="font-size: 15px; font-weight: 700;">
              @Taharah.Core.Calendar.HDate.ToGematriya(startH.Day) @startH.GetMonthName() — @Taharah.Core.Calendar.HDate.ToGematriya(endH.Day) @endH.GetMonthName()
            </div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
              (@startGreg.ToString("dd/MM") עד @endGreg.ToString("dd/MM"))
            </div>
          </div>
        }

        @if (Report.ExpectedTevilahAbs.HasValue)
        {
          var tevH = new Taharah.Core.Calendar.HDate(Report.ExpectedTevilahAbs.Value);
          var tevGreg = new DateTime(1, 1, 1).AddDays(Report.ExpectedTevilahAbs.Value - 1);
          <div style="flex: 1; min-width: 240px; background: rgba(30, 58, 95, 0.05); border-radius: var(--radius-md); padding: 14px; border: 1px solid rgba(30, 58, 95, 0.15);">
            <div style="font-size: 12px; font-weight: 700; color: var(--primary); margin-bottom: 4px;">ליל טבילה משוער הבא</div>
            <div style="font-size: 15px; font-weight: 700; color: var(--primary);">
              @Taharah.Core.Calendar.HDate.ToGematriya(tevH.Day) @tevH.GetMonthName() (אור ליום @Taharah.Core.Calendar.HDate.ToGematriya(tevH.Day))
            </div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
              (@tevGreg.ToString("dd/MM/yyyy"))
            </div>
          </div>
        }
      </div>
    </div>
  }

  <!-- Medical & Halachic Disclaimer -->
  <div style="background: var(--bg-surface-subtle); border-radius: var(--radius-md); padding: 16px 20px; border: 1px solid var(--border-subtle); display: flex; gap: 12px; align-items: flex-start;">
    <div style="color: var(--text-muted); padding-top: 2px;">
      <SvgIcon Name="sign" Size="20" />
    </div>
    <div style="font-size: 12.5px; color: var(--text-muted); line-height: 1.5;">
      <b>הבהרה הלכתית ורפואית:</b> @Taharah.Core.Algorithms.FertilityInsightsManager.Disclaimer
    </div>
  </div>
</div>

@code {
  protected override void OnInitialized()
  {
    State.OnChange += OnStateChanged;
  }

  private void OnStateChanged()
  {
    InvokeAsync(StateHasChanged);
  }

  public void Dispose()
  {
    State.OnChange -= OnStateChanged;
  }

  private Taharah.Core.Algorithms.FertilityCycleReport Report => 
    Taharah.Core.Algorithms.FertilityInsightsManager.Analyze(State.AllEvents);
}
