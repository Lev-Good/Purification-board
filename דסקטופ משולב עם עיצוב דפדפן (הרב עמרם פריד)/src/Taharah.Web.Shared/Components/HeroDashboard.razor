@namespace Taharah.Web.Shared.Components
@inject Taharah.Web.Shared.Services.CalendarStateService State
@implements IDisposable

<section class="hero-wrapper">
  <div class="serene-hero-card">
    <div class="icon-glow-container">
      <SvgIcon Name="leaf" Class="icon-leaf" Style="width: 32px; height: 32px; color: var(--nekiim-fg);" />
    </div>

    <div class="status-headline">
      <h2>
        <span>@State.HeroStatusTitle</span>
        <span class="sunset-capsule">
          <SvgIcon Name="sun" Class="icon-sun" Style="width: 14px; height: 14px; color: var(--prisha-day-fg);" />
          שקיעה היום: @State.TodaySunset
        </span>
      </h2>
      <p>@State.HeroStatusDescription</p>

      @if (State.NekiyimProgressDay > 0)
      {
        <div class="stepper-belt">
          @for (int day = 1; day <= 7; day++)
          {
            int currentDay = day;
            string hebNum = Taharah.Core.Calendar.HDate.ToGematriya(currentDay);
            if (currentDay < State.NekiyimProgressDay)
            {
              <div class="step-bubble passed">✓ יום @hebNum׳</div>
            }
            else if (currentDay == State.NekiyimProgressDay)
            {
              <div class="step-bubble active-today">היום: יום @hebNum׳</div>
            }
            else
            {
              <div class="step-bubble">יום @hebNum׳</div>
            }
          }
          <div class="step-bubble target-mikveh">
            <SvgIcon Name="waves" Class="icon-waves" Style="width: 13px; height: 13px;" />
            ליל טבילה @(State.NextMikvehDateFormatted != null ? $"({State.NextMikvehDateFormatted})" : "")
          </div>
        </div>
      }
    </div>

    <div>
      <button class="hero-action-button" @onclick='() => State.OpenGuidedAction("check")'>
        <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
        הזנת בדיקה עכשיו
      </button>
    </div>
  </div>
</section>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}

