@namespace Taharah.Web.Shared.Components
@inject Taharah.Web.Shared.Services.CalendarStateService State
@implements IDisposable

<div class="view-container active">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
    <div>
      <h2 style="font-size: 22px; font-weight: 800; letter-spacing: -0.3px; margin: 0 0 4px 0;">ריכוז וסתות ותאריכי פרישה עתידיים</h2>
      <p style="font-size: 13.5px; color: var(--text-muted); margin: 0;">טבלת מעקב אוטומטית המחושבת לפי פסקי הגר״ע פריד שליט״א</p>
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
      <button type="button" class="btn btn-secondary" onclick="window.taharahInterop.printPage()" style="display: flex; align-items: center; gap: 6px; padding: 7px 14px; font-size: 12.5px;">
        <SvgIcon Name="print" Style="width: 14px; height: 14px;" />
        הדפס ריכוז וסתות
      </button>
    </div>
  </div>

  <!-- Silek Damim Banner -->
  @if (State.EngineResult?.Life?.Silek == true)
  {
    var life = State.EngineResult.Life;
    string labels = (life.SilekLabels != null && life.SilekLabels.Count > 0)
      ? $" ({string.Join(", ", life.SilekLabels)})"
      : "";
    <div style="background: rgba(234, 88, 12, 0.08); border: 1px solid rgba(234, 88, 12, 0.25); border-radius: var(--radius-md); padding: 14px 18px; margin-bottom: 18px; display: flex; align-items: center; gap: 12px;">
      <SvgIcon Name="alert" Style="color: var(--accent-cycle); width: 22px; height: 22px; flex-shrink: 0;" />
      <div>
        <div style="font-weight: 700; font-size: 14px; color: var(--accent-cycle);">מסולקת דמים@labels:</div>
        <div style="font-size: 12.5px; color: var(--text-secondary); margin-top: 2px;">
          החששות המפורטים בטבלה אינם נוהגים לה — אין חוששין לוסתות שהיו לה קודם שנסתלקה, והיא פטורה מבדיקה. וכלל זה אינו חל על ראייה שתראה בתוך זמן הסילוק.
        </div>
      </div>
    </div>
  }
  else if (State.EngineResult?.Life?.Dormancy.Ended == true)
  {
    <div style="background: rgba(234, 88, 12, 0.08); border: 1px solid rgba(234, 88, 12, 0.25); border-radius: var(--radius-md); padding: 14px 18px; margin-bottom: 18px; display: flex; align-items: center; gap: 12px;">
      <SvgIcon Name="alert" Style="color: var(--accent-cycle); width: 22px; height: 22px; flex-shrink: 0;" />
      <div>
        <div style="font-weight: 700; font-size: 14px; color: var(--accent-cycle);">תם הסילוק:</div>
        <div style="font-size: 12.5px; color: var(--text-secondary); margin-top: 2px;">
          החששות המפורטים בטבלה אינם חוזרים, שאינה שבה אלא לוסתה שהיתה קבועה קודם הסילוק.
        </div>
      </div>
    </div>
  }

  <!-- Active Fixed Vesets Banner -->
  @if (State.ActiveFixedVesets.Count > 0)
  {
    <div style="background: rgba(22, 101, 52, 0.08); border: 1px solid rgba(22, 101, 52, 0.25); border-radius: var(--radius-md); padding: 14px 18px; margin-bottom: 18px; display: flex; align-items: center; gap: 12px;">
      <SvgIcon Name="check-circle" Style="color: #16a34a; width: 22px; height: 22px; flex-shrink: 0;" />
      <div>
        <div style="font-weight: 700; font-size: 14px; color: #16a34a;">
          נקבעה וסת קבועה: @(string.Join(" · ", State.ActiveFixedVesets.Select(Taharah.Core.Algorithms.ChazakaManager.DescribeVeset)))
        </div>
        <div style="font-size: 12.5px; color: var(--text-secondary); margin-top: 2px;">
          מכוח וסת קבועה זו אין חוששים לשאר החששות שבטבלה, אלא לוסת זו בלבד.
        </div>
      </div>
    </div>
  }

  <table class="editorial-table">
    <thead>
      <tr>
        <th>תאריך ראייה</th>
        <th>הפלגה (ימים)</th>
        <th>עונה בינונית (ל׳ + ל״א)</th>
        <th>וסת יום החודש</th>
        <th>הפלגה עתידית צפויה</th>
        <th>סטטוס וסת</th>
      </tr>
    </thead>
    <tbody>
      @if (State.EngineResult != null && State.EngineResult.Reiyot.Count > 0)
      {
        @foreach (var reiyah in State.EngineResult.Reiyot.OrderByDescending(r => r.Abs))
        {
          var hDate = reiyah.HDate;
          var greg = hDate.Greg();
          int? haflagah = reiyah.HaflagahDiff;
          
          <tr>
            <td>
              <b>@Taharah.Core.Calendar.HDate.ToGematriya(hDate.Day) @hDate.GetMonthName() @Taharah.Core.Calendar.HDate.ToGematriyaYear(hDate.Year)</b>
              <div style="font-size: 11.5px; color: var(--text-muted);">עונת @(reiyah.Ona == Taharah.Core.Enums.OnaType.Night ? "לילה" : "יום") (@greg.ToString("dd/MM/yyyy"))</div>
              @if (reiyah.Signs.Count > 0)
              {
                <div style="font-size: 11px; color: var(--primary); margin-top: 4px;">
                  מיחוש: @string.Join(", ", reiyah.Signs.Select(s => Taharah.Core.Algorithms.VesetGufManager.BodySignLabel(s)))
                </div>
              }
            </td>
            <td>
              @if (haflagah.HasValue)
              {
                <b style="font-size: 16px; color: var(--primary);">@haflagah.Value</b>
              }
              else
              {
                <span>—</span>
              }
            </td>
            <td>
              @{
                var b30 = new Taharah.Core.Calendar.HDate(reiyah.Abs + 29);
                var b31 = new Taharah.Core.Calendar.HDate(reiyah.Abs + 30);
              }
              <div>@Taharah.Core.Calendar.HDate.ToGematriya(b30.Day) @b30.GetMonthName()</div>
              <div style="font-size: 11px; color: var(--text-muted);">וחומרא: @Taharah.Core.Calendar.HDate.ToGematriya(b31.Day) @b31.GetMonthName() (ל״א)</div>
            </td>
            <td>
              @{
                var yh = Taharah.Core.Algorithms.VesetEngine.GetYomHachodeshInfo(hDate);
                bool disputed = (yh.Mode == "disputed" && yh.Entries.Count > 1);
                string yomHachodeshText;
                if (yh.Entries.Count == 1)
                {
                  var d = new Taharah.Core.Calendar.HDate(yh.Entries[0].Abs);
                  yomHachodeshText = $"{Taharah.Core.Calendar.HDate.ToGematriya(d.Day)} {d.GetMonthName()}";
                }
                else if (yh.Entries.Count > 1)
                {
                  yomHachodeshText = string.Join(" או ", yh.Entries.Select(e => {
                    var d = new Taharah.Core.Calendar.HDate(e.Abs);
                    return $"{Taharah.Core.Calendar.HDate.ToGematriya(d.Day)} {d.GetMonthName()}";
                  }));
                }
                else
                {
                  yomHachodeshText = $"{Taharah.Core.Calendar.HDate.ToGematriya(hDate.Day)} בחדש";
                }
              }
              <div>@yomHachodeshText</div>
              @if (disputed)
              {
                <span class="badge-pill" style="background: rgba(234, 88, 12, 0.15); color: #c2410c; font-size: 10.5px; font-weight: 700; margin-top: 4px; display: inline-block;">
                  ⚠ מחלוקת — יש לשאול רב
                </span>
              }
            </td>
            <td>
              @if (reiyah.NextHaflagahDate != null)
              {
                <b>@Taharah.Core.Calendar.HDate.ToGematriya(reiyah.NextHaflagahDate.Day) @reiyah.NextHaflagahDate.GetMonthName()</b>
              }
              else
              {
                <span>—</span>
              }
            </td>
            <td>
              @if (reiyah.Establishing)
              {
                <span class="badge-pill hefsek">✓ קובעת וסת</span>
              }
              else if (reiyah.Counted)
              {
                <span class="badge-pill prisha-night">ראייה נספרת</span>
              }
              else
              {
                <span class="badge-pill" style="background: var(--bg-surface-subtle); color: var(--text-muted);">ראייה ראשונה</span>
              }
            </td>
          </tr>
        }
      }
      else
      {
        <tr>
          <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 30px;">
            טרם נרשמו ראיות בלוח. לחצי על יום בלוח ובחרי "תחילת מחזור" להזנת נתונים ראשונה.
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
