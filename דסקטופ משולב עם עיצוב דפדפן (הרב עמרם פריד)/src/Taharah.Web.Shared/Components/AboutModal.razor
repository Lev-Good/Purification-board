@namespace Taharah.Web.Shared.Components
@inject Taharah.Web.Shared.Services.CalendarStateService State
@implements IDisposable

@if (State.IsAboutOpen)
{
  <div class="modal-backdrop-overlay" @onclick="State.CloseAbout">
    <div class="modal-content-card about-modal-card" @onclick:stopPropagation="true">
      <!-- Modal Header -->
      <div class="modal-card-header">
        <div>
          <div class="modal-title-row">
            <SvgIcon Name="book" Style="width: 22px; height: 22px; color: var(--primary);" />
            <h2>אודות והוראות שימוש</h2>
          </div>
          <div class="modal-subtitle">לוח טהרה — מהדורת הלכות טהרה (פסקי הגר״ע פריד שליט״א)</div>
        </div>
        <button class="close-btn-circle" title="סגור (Esc)" @onclick="State.CloseAbout">✕</button>
      </div>

      <!-- Scrollable Body -->
      <div class="modal-card-body about-scroll-body">
        <!-- 1. How to use -->
        <section class="about-section-card">
          <div class="about-section-head">
            <SvgIcon Name="guide" Style="width: 18px; height: 18px; color: var(--primary);" />
            <h3>איך משתמשים ביומן?</h3>
          </div>
          <div class="about-text-content">
            <p>
              <b>הזנת נתונים: </b>
              לחצו על כל תאריך בלוח השנה כדי לפתוח את תפריט הפעולות המהירות וההזנה המודרכת לאותו יום.
            </p>
            <p>
              <b>תחילת מחזור (ראייה): </b>
              סמנו ״תחילת מחזור״ ובחרו אם הראייה אירעה בעונת יום (מנץ החמה עד שקיעה) או בעונת לילה (משקיעה עד הנץ). המנוע ההלכתי יחשב מיד את ימי ועונות הפרישה הבאים.
            </p>
            <p>
              <b>הבנת התצוגה בלוח (יום מול לילה): </b>
              על פי ההלכה היהודית הלילה הולך אחר היום שאחריו וקודם לו. בכל משבצת יום בלוח יש הפרדה ברורה בין חלק הלילה (למעלה) לחלק היום (למטה).
            </p>
            <p>
              <b>תהליך הטהרה (הפסק ושבעה נקיים): </b>
              ביום ביצוע ״הפסק טהרה״ (לפני השקיעה) סמנו זאת בלוח. המערכת תסמן אוטומטית את שבעת הנקיים ותחשב את צפי ליל הטבילה במקווה לליל יום שמיני.
            </p>
            <p>
              <b>קיצורים הלכתיים בלוח: </b>
              עו״ב (עונה בינונית — יום ה-30), עו״ה (עונת הפלגה), יו״ח (יום החודש), עוא״ז (עונת אור זרוע), וק״ח (וסת קבוע החודש). ניתן לעבור לטאב 
              <button class="text-link-btn" @onclick='() => { State.CloseAbout(); State.ActiveView = "guide"; }'>המדריך ההלכתי</button>
              לעיון מלא בכל המקורות.
            </p>
          </div>
        </section>

        <!-- 2. Privacy & Security -->
        <section class="about-section-card">
          <div class="about-section-head">
            <SvgIcon Name="shield" Style="width: 18px; height: 18px; color: var(--primary);" />
            <h3>פרטיות, אבטחה וגיבוי מקומי</h3>
          </div>
          <div class="about-text-content">
            <p>
              <b>אבטחה מקסימלית ללא ענן: </b>
              כל הנתונים והרישומים שלכם נשמרים אך ורק במחשב האישי שלכם. שום נתון אינו מועבר לשום שרת חיצוני בעולם.
            </p>
            <p>
              <b>קוד נעילה והצפנת מסד: </b>
              בלחיצה על אייקון ההגדרות תוכלו להגדיר קוד אישי (PIN). הגדרת הקוד מצפינה את כל בסיס הנתונים בהצפנה צבאית AES-GCM-256.
            </p>
            <p>
              <b>גיבוי מקומי: </b>
              מומלץ ביותר לייצא מעת לעת קובץ גיבוי JSON מטאב ״גיבוי וסנכרון״ בהגדרות, כדי שתוכלו לשחזר את הנתונים בכל עת או להעבירם למחשב חדש.
            </p>
          </div>
        </section>

        <!-- 3. Halachic Attribution -->
        <section class="about-section-card">
          <div class="about-section-head">
            <SvgIcon Name="scales" Style="width: 18px; height: 18px; color: var(--primary);" />
            <h3>הלכה ופסיקה</h3>
          </div>
          <div class="about-text-content">
            <p>
              חישובי הפרישה, שבעה נקיים, קביעת ועקירת וסתות, וסת הגוף, מסולקות דמים ומנהגי עדות (אשכנז ועדות המזרח) — נבנו ופותחו בהתאמה מדוקדקת ומאומתת לפסקי מורה ההוראה הגאון הגדול הרב עמרם פריד שליט״א.
            </p>
          </div>
        </section>

        <!-- 4. Version & Updates -->
        <section class="about-section-card">
          <div class="about-section-head">
            <SvgIcon Name="sparkle" Style="width: 18px; height: 18px; color: var(--primary);" />
            <h3>גרסה ועדכונים</h3>
          </div>
          <div class="about-text-content">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
              <div>
                <b>גרסה נוכחית: </b> v3.4.1 (מהדורה אחודה דסקטופ ודפדפן)
              </div>
              <button class="round-arrow" style="width: auto; padding: 6px 16px; font-size: 12.5px;" disabled="@State.IsCheckingUpdate" @onclick="State.CheckForUpdatesAsync">
                @(State.IsCheckingUpdate ? "בודק עדכונים..." : "בדוק עדכונים ב-GitHub")
              </button>
            </div>
            @if (!string.IsNullOrEmpty(State.UpdateStatusMessage))
            {
              <div class="status-msg-box" style="margin-top: 10px;">
                @State.UpdateStatusMessage
                @if (!string.IsNullOrEmpty(State.LatestReleaseUrl))
                {
                  <div style="margin-top: 6px;">
                    <button class="text-link-btn" @onclick='() => State.OpenExternalUrlAsync(State.LatestReleaseUrl)'>לחצו כאן לפתיחת עמוד השחרור</button>
                  </div>
                }
              </div>
            }
          </div>
        </section>

        <!-- 5. Credits & Support -->
        <section class="about-section-card credit-box">
          <div style="text-align: center; margin-bottom: 8px;">
            <SvgIcon Name="heart" Style="width: 24px; height: 24px; color: var(--primary);" />
          </div>
          <h4 style="text-align: center; margin: 0 0 6px 0; font-size: 14px;">פותח באהבה ובמחשבה רבה על ידי לב טוב</h4>
          <p style="text-align: center; font-size: 12.5px; color: var(--text-muted); margin: 0 0 8px 0;">
            לשאלות הלכתיות, הצעות לשיפור או תמיכה טכנית:
          </p>
          <div style="text-align: center;">
            <a href="mailto:myylbwt@gmail.com" class="support-email-badge">myylbwt@gmail.com</a>
          </div>
        </section>
      </div>

      <!-- Modal Footer -->
      <div class="modal-card-footer">
        <button class="hero-action-button" style="padding: 8px 24px;" @onclick="State.CloseAbout">סגור</button>
      </div>
    </div>
  </div>
}

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
