@namespace Taharah.Web.Shared.Components
@inject Taharah.Web.Shared.Services.CalendarStateService State
@implements IDisposable

@if (State.HasDayStatePanel)
{
  <div class="day-state-alerts-container">
    @if (State.HasOpenFright)
    {
      <div class="alert-banner fright-alert">
        <div class="alert-icon-wrap">
          <SvgIcon Name="alert" Style="width: 18px; height: 18px; color: var(--danger, #dc2626);" />
        </div>
        <div class="alert-text-content">
          <div class="alert-heading">פחד פתאום (ביעתותא) — טרם נברר</div>
          <div class="alert-body">@State.OpenFrightText</div>
        </div>
      </div>
    }

    @if (State.HasAnxiety)
    {
      <div class="alert-banner anxiety-alert">
        <div class="alert-icon-wrap">
          <SvgIcon Name="info" Style="width: 18px; height: 18px; color: var(--warning, #d97706);" />
        </div>
        <div class="alert-text-content">
          <div class="alert-heading">חרדה מתמשכת</div>
          <div class="alert-body">@State.AnxietyText</div>
        </div>
      </div>
    }

    @if (State.OrZaruaExemptionItems.Count > 0)
    {
      @foreach (var item in State.OrZaruaExemptionItems)
      {
        <div class="alert-banner orzarua-alert">
          <div class="alert-icon-wrap">
            <SvgIcon Name="check-circle" Style="width: 18px; height: 18px; color: var(--success, #16a34a);" />
          </div>
          <div class="alert-text-content">
            <div class="alert-heading">עונת אור זרוע שנפטרה כדין</div>
            <div class="alert-body">@item</div>
          </div>
        </div>
      }
    }
  </div>
}

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
