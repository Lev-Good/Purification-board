@namespace Taharah.Web.Shared.Components
@inject Taharah.Web.Shared.Services.CalendarStateService State
@implements IDisposable

<div class="month-controls-wrap">
  <div class="month-picker-cluster">
    <div class="arrows-group">
      <button class="round-arrow" title="חודש קודם" @onclick="() => State.NavigateMonthAsync(-1)">
        <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      <button class="round-arrow" title="חודש הבא" @onclick="() => State.NavigateMonthAsync(1)">
        <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
    </div>
    
    <div class="month-text-group">
      <div class="heb-title-display">@State.CurrentMonth.GetMonthName() @Taharah.Core.Calendar.HDate.ToGematriyaYear(State.CurrentMonth.Year)</div>
      <div class="greg-sub-display">@State.CurrentMonth.Greg().ToString("MMMM yyyy", new System.Globalization.CultureInfo("he-IL"))</div>
    </div>

    <button class="today-chip" @onclick="State.GoToTodayAsync">חזרה להיום</button>

    <button class="today-chip" style="background: var(--bg-surface); border-color: var(--border-subtle); color: var(--text-secondary);" 
            title="מעבר לתצוגה שנתית" @onclick="State.ToggleYearlyView">
      <SvgIcon Name="calendar-year" Style="width: 13px; height: 13px; margin-left: 5px;" />
      תצוגה שנתית
    </button>
  </div>

  <div style="display: flex; gap: 8px; align-items: center;">
    <button class="city-selector-chip" title="לחץ לשינוי עיר בהגדרות" @onclick='() => State.OpenSettings("location")'>
      <SvgIcon Name="location" Style="width: 14px; height: 14px; color: var(--primary);" />
      <span>עיר: <b>@State.SelectedLocation.Label</b></span>
    </button>

    <span class="badge-pill hefsek" style="font-size: 12px; padding: 4px 10px;">
      <svg class="svg-icon" style="width: 13px; height: 13px;" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="20 6 9 17 4 12"></polyline></svg>
      מנוע הלכתי פעיל 100%
    </span>
  </div>
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
