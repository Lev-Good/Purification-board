@namespace Taharah.Web.Shared.Components
@using Taharah.Core.Enums
@inject Taharah.Web.Shared.Services.CalendarStateService State
@implements IDisposable

<aside class="drawer-sidebar" style="display: @(State.IsDrawerOpen ? "flex" : "none")">
  @if (State.SelectedDay != null)
  {
    var day = State.SelectedDay;
    <div class="drawer-head-box">
      <div class="drawer-head-row">
        <div>
          <div class="drawer-main-title">@day.HebDayGematriya @day.HDate.GetMonthName() @Taharah.Core.Calendar.HDate.ToGematriyaYear(day.HDate.Year)</div>
          <div class="drawer-sec-date">יום @GetDayOfWeekName(day.GregDate.DayOfWeek), @day.GregDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("he-IL"))</div>
          <div class="drawer-chips-flex">
            @if (!string.IsNullOrEmpty(day.SunriseTime))
            {
              <span class="zman-capsule">נץ: @day.SunriseTime</span>
            }
            @if (!string.IsNullOrEmpty(day.SunsetTime))
            {
              <span class="zman-capsule">שקיעה: @day.SunsetTime</span>
            }
            @if (day.IsShevaNekiyimDay)
            {
              <span class="badge-pill nekiim">שבעה נקיים — יום @Taharah.Core.Calendar.HDate.ToGematriya(day.ShevaNekiyimDayNumber)</span>
            }
          </div>
        </div>
        <button class="close-btn-circle" title="סגור חלונית" @onclick="State.CloseDrawer">✕</button>
      </div>
    </div>

    <div class="drawer-scroll-content">
      <!-- Halachic Concerns for this day -->
      @if (day.HalachicPrishot.Count > 0)
      {
        <div>
          <div class="group-title-label">
            <span>עונות פרישה וחישובים להיום</span>
            @{
              int activeCount = day.HalachicPrishot.Count(p => !p.Uprooted);
              int uprootedCount = day.HalachicPrishot.Count(p => p.Uprooted);
            }
            @if (activeCount > 0)
            {
              <span class="tag-counter">@activeCount פעילים</span>
            }
            @if (uprootedCount > 0)
            {
              <span class="tag-counter" style="background: var(--bg-surface-subtle); color: var(--text-muted);">@uprootedCount נעקרו</span>
            }
          </div>

          @foreach (var prisha in day.HalachicPrishot)
          {
            bool isDay = prisha.Ona == OnaType.Day;
            <div class="halacha-banner-card @(prisha.Uprooted ? "uprooted-flavor" : (isDay ? "day-flavor" : "night-flavor"))" style="@(prisha.Uprooted ? "opacity: 0.7; border-style: dashed;" : "")">
              <div class="title-line">
                <span style="display: flex; align-items: center; gap: 6px;">
                  <SvgIcon Name="@(isDay ? "sun" : "moon")" Style="width: 15px; height: 15px;" />
                  @prisha.Code — @(isDay ? "עונת יום" : "עונת לילה")
                  @if (prisha.Uprooted)
                  {
                    <span class="badge-pill prisha-uprooted" style="margin-right: 6px; font-size: 11px;">נעקרה</span>
                  }
                </span>
                <span style="font-size: 11px;">@(prisha.Uprooted ? "נעקרה — עבר הזמן" : (isDay ? "נץ עד שקיעה" : "מעת לעת"))</span>
              </div>
              <div class="desc-line">@prisha.Reason</div>
            </div>
          }
        </div>
      }

      <!-- Saved records -->
      @if (day.SavedEntry != null)
      {
        var e = day.SavedEntry;
        <div>
          <div class="group-title-label">
            <span>רישום שנשמר ליום זה</span>
            <span class="tag-counter">פעיל</span>
          </div>

          <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 12px; padding: 14px 16px; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
              <div>
                <div style="font-weight: 800; font-size: 14.5px; display: flex; align-items: center; gap: 8px;">
                  <SvgIcon Name="@GetEntryIcon(e.Type)" Style="color: var(--primary); width: 18px; height: 18px;" />
                  @GetEntryTitle(e.Type)
                  <span class="badge-pill @(e.Ona == OnaType.Night ? "prisha-night" : "hefsek")" style="font-size: 11px;">
                    @(e.Ona == OnaType.Night ? "עונת לילה" : "עונת יום")
                  </span>
                </div>
              </div>
              <div style="display: flex; gap: 8px;">
                <button type="button" class="btn btn-secondary" style="padding: 4px 10px; font-size: 11.5px; border-radius: 6px; display: flex; align-items: center; gap: 4px;" title="ערוך רישום זה" @onclick="State.OpenEditEntry">
                  ערוך
                </button>
                <button type="button" class="btn btn-secondary" style="padding: 4px 8px; font-size: 11.5px; border-radius: 6px; color: var(--accent-cycle);" title="מחק רישום זה" @onclick="State.DeleteCurrentDayEventAsync">
                  <SvgIcon Name="trash" Style="width: 14px; height: 14px;" />
                </button>
              </div>
            </div>

            <!-- Details Chips -->
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px;">
              @if (e.Type == "reiyah")
              {
                <span class="badge-pill" style="background: var(--bg-surface-subtle); border: 1px solid var(--border-subtle); font-size: 11.5px;">
                  @GetReiyahKindLabel(e.Kind)
                </span>
                @if (e.DurationDays > 1)
                {
                  <span class="badge-pill" style="background: var(--bg-surface-subtle); border: 1px solid var(--border-subtle); font-size: 11.5px;">
                    דימום נמשך @e.DurationDays ימים
                  </span>
                }
                @if (e.SafekOna)
                {
                  <span class="badge-pill prisha-night" style="font-size: 11.5px;">ספק עונה</span>
                }
                @if (e.ClosedFountain == true)
                {
                  <span class="badge-pill" style="background: var(--bg-surface-subtle); font-size: 11.5px;">המשך ראייה (משיכת ראייה)</span>
                }
                @foreach (var s in e.Signs)
                {
                  <span class="badge-pill hefsek" style="font-size: 11.5px;">מיחוש: @GetSignLabel(s)</span>
                }
              }
              else if (e.Type == "hefsek")
              {
                @if (e.CheckParts.Contains("moch"))
                {
                  <span class="badge-pill hefsek" style="font-size: 11.5px;">✓ בדיקת מוך דחוק</span>
                }
                else
                {
                  <span class="badge-pill" style="background: var(--bg-surface-subtle); font-size: 11.5px;">הפסק ללא מוך</span>
                }
              }
              else if (e.Type == "check")
              {
                <span class="badge-pill nekiim" style="font-size: 11.5px;">
                  @(e.Depth == "wipe" ? "קינוח בלבד (אינו עוקר)" : "בדיקה בעומק ובחו״ס")
                </span>
              }
              else if (e.Type == "mark")
              {
                @foreach (var m in e.Marks)
                {
                  <span class="badge-pill prisha-day" style="font-size: 11.5px;">@GetMarkLabel(m)</span>
                }
              }
              else if (e.Type == "sign")
              {
                @foreach (var s in e.Signs)
                {
                  <span class="badge-pill hefsek" style="font-size: 11.5px;">מיחוש: @GetSignLabel(s)</span>
                }
                <span class="badge-pill" style="background: var(--bg-surface-subtle); font-size: 11.5px;">
                  @(e.SignCertainty == "vague" ? "מיחוש רחוק" : e.SignCertainty == "likely" ? "סביר שיבוא בקרוב" : "ודאי שיבוא מיד")
                </span>
              }
            </div>

            @if (!string.IsNullOrWhiteSpace(e.Note))
            {
              <div style="font-size: 12px; color: var(--text-muted); background: var(--bg-surface-subtle); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-subtle); margin-top: 6px;">
                <b>הערה:</b> @e.Note
              </div>
            }
          </div>
        </div>
      }

      <!-- Guided Form -->
      <GuidedEventForm />

      <!-- Quick Actions Deck -->
      <div id="quickActionsDeck" style="opacity: @(State.IsGuidedFormOpen ? "0.4" : "1")">
        <div class="group-title-label">
          <span>פעולות מהירות להיום</span>
        </div>

        <div class="action-cards-deck">
          <button class="action-tile-btn t-cycle" @onclick='() => State.OpenGuidedAction("sighting")'>
            <div class="tile-icon-wrap">
              <SvgIcon Name="cycle" />
            </div>
            <span class="tile-title-txt">תחילת מחזור</span>
            <span class="tile-subtitle-txt">ראייה חדשה ודימום</span>
          </button>

          <button class="action-tile-btn t-hefsek" @onclick='() => State.OpenGuidedAction("hefsek")'>
            <div class="tile-icon-wrap">
              <SvgIcon Name="leaf" />
            </div>
            <span class="tile-title-txt">הפסק טהרה</span>
            <span class="tile-subtitle-txt">לפני שקיעת החמה</span>
          </button>

          <button class="action-tile-btn t-check" @onclick='() => State.OpenGuidedAction("check")'>
            <div class="tile-icon-wrap">
              <SvgIcon Name="lens" />
            </div>
            <span class="tile-title-txt">בדיקת נקיים</span>
            <span class="tile-subtitle-txt">בעומק ובחו״ס</span>
          </button>

          <button class="action-tile-btn t-mikveh" @onclick='() => State.OpenGuidedAction("tevilah")'>
            <div class="tile-icon-wrap">
              <SvgIcon Name="waves" />
            </div>
            <span class="tile-title-txt">טבילה במקווה</span>
            <span class="tile-subtitle-txt">בליל יום חמישי</span>
          </button>

          <button class="action-tile-btn t-mark" @onclick='() => State.OpenGuidedAction("mark")'>
            <div class="tile-icon-wrap">
              <SvgIcon Name="mark" />
            </div>
            <span class="tile-title-txt">סימון / כתם</span>
            <span class="tile-subtitle-txt">בירור כתם על בגד</span>
          </button>

          <button class="action-tile-btn t-sign" @onclick='() => State.OpenGuidedAction("sign")'>
            <div class="tile-icon-wrap">
              <SvgIcon Name="sign" />
            </div>
            <span class="tile-title-txt">מיחוש גופני</span>
            <span class="tile-subtitle-txt">הרגשת הגוף או כדורים</span>
          </button>
        </div>
      </div>
    </div>
  }
</aside>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }

    private string GetDayOfWeekName(DayOfWeek dow) => dow switch
    {
        DayOfWeek.Sunday => "ראשון",
        DayOfWeek.Monday => "שני",
        DayOfWeek.Tuesday => "שלישי",
        DayOfWeek.Wednesday => "רביעי",
        DayOfWeek.Thursday => "חמישי",
        DayOfWeek.Friday => "שישי",
        DayOfWeek.Saturday => "שבת",
        _ => ""
    };

    private string GetEntryTitle(string type) => type switch
    {
        "reiyah" => "תחילת מחזור (ראייה)",
        "hefsek" => "הפסק טהרה",
        "check" => "בדיקה כדין",
        "tevilah" => "טבילה במקווה",
        "mark" => "כתם",
        "sign" => "מיחוש",
        _ => "רישום"
    };

    private string GetEntryIcon(string type) => type switch
    {
        "reiyah" => "cycle",
        "hefsek" => "leaf",
        "check" => "lens",
        "tevilah" => "waves",
        "mark" => "mark",
        "sign" => "sign",
        _ => "calendar"
    };

    private string GetReiyahKindLabel(string? kind) => kind switch
    {
        "ones" => "מחמת אונס",
        "sharp" => "מחמת חריף",
        "pills" => "מחמת כדורים",
        "kefitza" => "מחמת קפיצה",
        _ => "ראייה רגילה"
    };

    private string GetSignLabel(string sign) => sign switch
    {
        "yawn" => "פיהוק",
        "sneeze" => "עיטוש",
        "cramps" => "כאבי בטן",
        "heaviness" => "כובד ראש",
        "chills" => "צמרמורת",
        "blood" => "שפיעת דם",
        "nausea" => "בחילה/הקאה",
        "weakness" => "חולשה",
        "facespots" => "פצעים",
        "sharpfood" => "מאכל חריף",
        _ => sign
    };

    private string GetMarkLabel(string mark) => mark switch
    {
        "stain" => "כתם שנבדק",
        "fright" => "פחד פתאום (ביעתותא)",
        "anxiety" => "חרדה מתמשכת",
        "travel" => "יציאה לדרך",
        "chuppah" => "ליל חופה",
        _ => mark
    };
}
