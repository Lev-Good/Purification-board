<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\Taharah.UI\icon.ico</ApplicationIcon>
    <AssemblyName>Taharah</AssemblyName>
    <Product>לוח טהרה (גרסה משולבת דסקטופ ודפדפן - הרב עמרם פריד)</Product>
    <Authors>Lev Good</Authors>
    <Version>3.4.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taharah.Web.Shared\Taharah.Web.Shared.csproj" />
    <ProjectReference Include="..\Taharah.Core\Taharah.Core.csproj" />
    <ProjectReference Include="..\Taharah.Infrastructure\Taharah.Infrastructure.csproj" />
  </ItemGroup>

</Project>

