{
  "name": "purification-board",
  "version": "1.2.0",
  "description": "אפליקציית חישוב ימי הטהרה ולוח שנה עברי",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "Lev Good",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "electron": "^25.3.0",
    "electron-builder": "^24.6.3"
  },
  "build": {
    "appId": "com.taharah.board",
    "productName": "לוח טהרה",
    "icon": "icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "לוח טהרה"
    },
    "files": [
      "index.html",
      "hebcal.js",
      "main.js",
      "preload.js",
      "icon.png",
      "css/**/*",
      "js/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Lev-Good",
      "repo": "Purification-board"
    }
  },
  "allowScripts": {
    "electron@25.9.8": true
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
