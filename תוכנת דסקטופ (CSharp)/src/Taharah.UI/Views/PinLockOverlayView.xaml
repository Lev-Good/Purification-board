<UserControl x:Class="Taharah.UI.Views.PinLockOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBorderBrush}">
        <ui:Card Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="36"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <ui:Card.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.12" Direction="270" ShadowDepth="4"/>
            </ui:Card.Effect>

            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock Text="&#xE72E;" Style="{StaticResource IconGlyphStyle}" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="לוח טהרה — מערכת נעולה" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="הזיני את קוד ה-PIN האישי לפתיחת הלוח" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,24"/>

                <!-- PIN Input Box -->
                <PasswordBox x:Name="PinPasswordBox" 
                             PasswordChanged="OnPasswordChanged"
                             FontSize="22" 
                             HorizontalContentAlignment="Center" 
                             Padding="10" 
                             Margin="0,0,0,12" 
                             BorderBrush="{DynamicResource BorderLightBrush}" 
                             BorderThickness="1"/>

                <TextBlock Text="{Binding PinErrorMessage}" 
                           Foreground="#DC2626" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,14"
                           Visibility="{Binding PinErrorMessage.Length, Converter={StaticResource BoolToVis}}"/>

                <ui:Button Content="שחרר נעילה (Enter)"
                           Command="{Binding UnlockAppCommand}"
                           Appearance="Primary"
                           FontWeight="Bold"
                           FontSize="14"
                           Padding="14,10"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                <!-- Forgot-PIN alternative (js/security.js's toggleForgotPasswordView) -->
                <TextBlock Text="שכחתי קוד גישה"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"
                           Cursor="Hand"
                           TextDecorations="Underline">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleForgotPinPanelCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>

                <StackPanel Visibility="{Binding IsForgotPinPanelOpen, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                    <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1,0,0,0" Margin="0,0,0,12"/>

                    <StackPanel Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ניתן לשחזר את הנתונים ואת קוד ה-PIN מהגיבוי האחרון שנשמר בחשבון הגוגל המחובר במחשב זה. פעולה זו תחליף את הנתונים המקומיים בנתוני הגיבוי."
                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ui:Button Content="שחזר מגוגל והיכנס"
                                   Command="{Binding RestoreFromGoogleAndEnterCommand}"
                                   Appearance="Primary"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Padding="12,9"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource InverseBoolToVis}}"
                               Text="לא מחובר חשבון גוגל במחשב זה, ולכן אין אפשרות שחזור אוטומטית. יש לפנות למי שהתקינה את התוכנה, או לבדוק אם קוד ה-PIN נשמר במקום אחר."
                               FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>


