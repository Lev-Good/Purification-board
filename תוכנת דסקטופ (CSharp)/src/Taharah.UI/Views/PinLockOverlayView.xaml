<UserControl x:Class="Taharah.UI.Views.PinLockOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
    </UserControl.Resources>

    <!-- שכבת אטימות מעל כל התוכנה: כל עוד ה-PIN לא הוזן נכון, שום דבר אינו נגיש. -->
    <Grid Background="{DynamicResource ScrimBrush}">
        <ui:Card Background="{DynamicResource SurfaceBrush}" Padding="34" MaxWidth="430"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <ui:Card.Effect>
                <DropShadowEffect BlurRadius="34" Color="#000000" Opacity="0.18" Direction="270" ShadowDepth="6"/>
            </ui:Card.Effect>

            <StackPanel HorizontalAlignment="Stretch">
                <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center"
                        Background="{DynamicResource PrimarySubtleBrush}">
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="24" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"/>
                </Border>

                <TextBlock Text="לוח טהרה — מערכת נעולה" FontSize="18" FontWeight="Bold" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="הזיני את קוד ה-PIN האישי לפתיחת הלוח" FontSize="12.5" Margin="0,5,0,22"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>

                <PasswordBox x:Name="PinPasswordBox"
                             PasswordChanged="OnPasswordChanged"
                             FontSize="22"
                             HorizontalContentAlignment="Center"
                             Padding="12,10"
                             Background="{DynamicResource InputBgBrush}"
                             BorderBrush="{DynamicResource BorderLightBrush}"
                             BorderThickness="1"
                             Margin="0,0,0,12"/>

                <Border Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,14"
                        Visibility="{Binding PinErrorMessage.Length, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PinErrorMessage}" Foreground="{DynamicResource DangerFgBrush}"
                               FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>

                <ui:Button Content="שחרר נעילה (Enter)" Command="{Binding UnlockAppCommand}"
                           Style="{StaticResource PrimaryButtonStyle}" FontSize="14" Padding="14,10"
                           HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                <!-- חלופת שחזור (js/security.js's toggleForgotPasswordView) -->
                <TextBlock Text="שכחתי קוד גישה" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,16,0,0" Cursor="Hand" TextDecorations="Underline">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleForgotPinPanelCommand}"/>
                    </TextBlock.InputBindings>
                </TextBlock>

                <StackPanel Visibility="{Binding IsForgotPinPanelOpen, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,14"/>

                    <StackPanel Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ניתן לשחזר את הנתונים ואת קוד ה-PIN מהגיבוי האחרון שנשמר בחשבון הגוגל המחובר במחשב זה. פעולה זו תחליף את הנתונים המקומיים בנתוני הגיבוי."
                                   FontSize="11.5" LineHeight="17" Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ui:Button Content="שחזר מגוגל והיכנס" Command="{Binding RestoreFromGoogleAndEnterCommand}"
                                   Style="{StaticResource PrimaryButtonStyle}" FontSize="13" Padding="12,9"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource InverseBoolToVis}}"
                               Text="לא מחובר חשבון גוגל במחשב זה, ולכן אין אפשרות שחזור אוטומטית. יש לפנות למי שהתקינה את התוכנה, או לבדוק אם קוד ה-PIN נשמר במקום אחר."
                               FontSize="11.5" LineHeight="17" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </Grid>
</UserControl>
