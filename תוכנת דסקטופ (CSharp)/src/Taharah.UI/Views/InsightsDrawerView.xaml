<UserControl x:Class="Taharah.UI.Views.InsightsDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="540"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- כרטיס מדד: אותה מסגרת לכל ששת המדדים, עם תווית מעל וערך בולט -->
        <Style x:Key="MetricCardStyle" TargetType="ui:Card" BasedOn="{StaticResource AppCardStyle}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>

        <Style x:Key="MetricUnitStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="4,0,0,3"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="EstimateRowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource WindowBgBrush}">
        <Grid Margin="22,18,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <ui:Button DockPanel.Dock="Left" Command="{Binding CloseInsightsCommand}"
                           Style="{StaticResource SubtleIconButtonStyle}" ToolTip="סגור (Esc)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <StackPanel>
                    <TextBlock Text="תובנות מחזור וחלון פוריות" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="ניתוח סטטיסטי מבוסס היסטוריית הראיות — מחושב מקומית במכשיר בלבד."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,22">

                    <!-- התרעת ביוץ לפני טבילה -->
                    <Border Style="{StaticResource InlineAlertBorderStyle}"
                            Visibility="{Binding ShowOvulationConflictAlert, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Alert24" Margin="0,0,8,0"
                                               Foreground="{DynamicResource WarningFgBrush}"/>
                                <TextBlock Text="התרעת ביוץ קודם טבילה" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource WarningStrongFgBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding FertilityReport.StatusMessage}" FontSize="12" LineHeight="18"
                                       Foreground="{DynamicResource WarningStrongFgBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- מדדי ליבה -->
                    <UniformGrid Columns="2" Margin="0,0,-10,4">
                        <ui:Card Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ממוצע אורך מחזור" Style="{StaticResource MetricLabelStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FertilityReport.AverageCycleLengthDays}" Style="{StaticResource MetricValueStyle}"/>
                                    <TextBlock Text="ימים" Style="{StaticResource MetricUnitStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="חציון ימי מחזור" Style="{StaticResource MetricLabelStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FertilityReport.MedianCycleLengthDays}" Style="{StaticResource MetricValueStyle}"/>
                                    <TextBlock Text="ימים" Style="{StaticResource MetricUnitStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="המחזור הקצר ביותר" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="{Binding FertilityReport.ShortestCycleDays, StringFormat='{}{0} ימים'}"
                                           FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="המחזור הארוך ביותר" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="{Binding FertilityReport.LongestCycleDays, StringFormat='{}{0} ימים'}"
                                           FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </ui:Card>
                    </UniformGrid>

                    <!-- הערכות לתקופה הקרובה -->
                    <ui:Card Style="{StaticResource AppSectionCardStyle}" Margin="0,4,10,14">
                        <StackPanel>
                            <TextBlock Text="הערכות לתקופה הקרובה" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>

                            <DockPanel Margin="0,0,0,9">
                                <TextBlock Text="מועד ביוץ משוער (שיא):" Style="{StaticResource EstimateRowLabelStyle}"/>
                                <TextBlock Text="{Binding OvulationDateFormatted}" FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource SuccessFgBrush}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,9">
                                <TextBlock Text="חלון פוריות משוער:" Style="{StaticResource EstimateRowLabelStyle}"/>
                                <TextBlock Text="{Binding FertileWindowFormatted}" FontWeight="SemiBold" FontSize="12"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource InfoFgBrush}"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,9">
                                <TextBlock Text="ראייה הבאה משוערת:" Style="{StaticResource EstimateRowLabelStyle}"/>
                                <TextBlock Text="{Binding NextReiyahDateFormatted}" FontWeight="SemiBold" FontSize="12.5"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>

                            <DockPanel>
                                <TextBlock Text="מחזורים שנותחו:" Style="{StaticResource EstimateRowLabelStyle}"/>
                                <TextBlock Text="{Binding FertilityReport.TotalRecordedCycles}" FontWeight="Bold" FontSize="12.5"
                                           HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>
                        </StackPanel>
                    </ui:Card>

                    <!-- הבהרה רפואית: מקופלת כברירת מחדל כדי לא לבזבז גובה, אבל לא נעלמת -->
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                        <StackPanel>
                            <Button Command="{Binding ToggleMedicalDisclaimerCommand}" Background="Transparent"
                                    BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Right" Padding="0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" Margin="0,0,7,0" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="הבהרה רפואית" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="הצג ▸"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMedicalDisclaimerExpanded}" Value="True">
                                                        <Setter Property="Text" Value="הסתר ▾"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding FertilityReport.MedicalDisclaimer}" FontSize="11" LineHeight="17"
                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                       Margin="0,9,0,0"
                                       Visibility="{Binding IsMedicalDisclaimerExpanded, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
