<UserControl x:Class="Taharah.UI.Views.InsightsDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="450"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <DockPanel>
                    <Button DockPanel.Dock="Left" 
                            Command="{Binding CloseInsightsCommand}" 
                            Background="Transparent" BorderThickness="0" 
                            Width="32" Height="32" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="תובנות מחזור וחלון פוריות" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                        <TextBlock Text="ניתוח סטטיסטי מבוסס היסטוריית הראיות" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Infertility Alert if present -->
                    <Border Visibility="{Binding ShowOvulationConflictAlert, Converter={StaticResource BoolToVis}}"
                            Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,6,0"/>
                                <TextBlock Text="התרעת ביוץ קודם טבילה" FontWeight="Bold" FontSize="13.5" Foreground="#92400E"/>
                            </DockPanel>
                            <TextBlock Text="{Binding FertilityReport.StatusMessage}" 
                                       FontSize="12" Foreground="#78350F" TextWrapping="Wrap" LineHeight="17"/>
                        </StackPanel>
                    </Border>

                    <!-- Core Metrics Grid -->
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,5,10">
                            <StackPanel>
                                <TextBlock Text="ממוצע אורך מחזור" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding FertilityReport.AverageCycleLengthDays}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                    <TextBlock Text=" ימים" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}" Margin="5,0,0,10">
                            <StackPanel>
                                <TextBlock Text="חציון ימי מחזור" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding FertilityReport.MedianCycleLengthDays}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                    <TextBlock Text=" ימים" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,5,10">
                            <StackPanel>
                                <TextBlock Text="המחזור הקצר ביותר" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding FertilityReport.ShortestCycleDays, StringFormat='{}{0} ימים'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MetricCardStyle}" Margin="5,0,0,10">
                            <StackPanel>
                                <TextBlock Text="המחזור הארוך ביותר" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding FertilityReport.LongestCycleDays, StringFormat='{}{0} ימים'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Cycle Estimates -->
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="הערכות לתקופה הקרובה" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,10"/>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="מועד ביוץ משוער (שיא):" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding OvulationDateFormatted}" FontWeight="Bold" FontSize="12.5" Foreground="#047857" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="חלון פוריות משוער:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding FertileWindowFormatted}" FontWeight="SemiBold" FontSize="12" Foreground="#0369A1" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="ראייה הבאה משוערת:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding NextReiyahDateFormatted}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel>
                                <TextBlock Text="מחזורים שנותחו:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding FertilityReport.TotalRecordedCycles}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Medical Disclaimer -->
                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                        <TextBlock Text="{Binding FertilityReport.MedicalDisclaimer}" 
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="16"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>


