<UserControl x:Class="Taharah.UI.Views.SettingsDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="450"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVis"/>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Scrollable Options -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <DockPanel>
                    <Button DockPanel.Dock="Left" 
                            Command="{Binding CloseSettingsCommand}" 
                            Background="Transparent" BorderThickness="0" 
                            Width="32" Height="32" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="הגדרות מערכת והלכה" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <!-- 1. Life State Profile -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="מצב חיים (מסולקת דמים)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="מעוברת אחר תשעים יום, מניקה, זקנה וקטנה - דינן שונה: אינן חוששות לוסתות שהיו להן קודם, ומסולקת דמים פטורה מבדיקה. מלאו רק את מה שרלוונטי." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <CheckBox Content="הפעל חישוב מצב חיים" IsChecked="{Binding SettingsVm.LifeEnabled}" Margin="0,0,0,10" FontSize="12.5"/>

                            <StackPanel Visibility="{Binding SettingsVm.LifeEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="תחילת ההריון (לפי מניין ליל טבילה):" FontSize="12" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding SettingsVm.LifePregnancyDate, Mode=TwoWay}" Margin="0,0,0,10"/>

                                <TextBlock Text="תאריך הלידה:" FontSize="12" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding SettingsVm.LifeBirthDate, Mode=TwoWay}" Margin="0,0,0,10"/>

                                <CheckBox Content="מניקה בימים אלה" IsChecked="{Binding SettingsVm.LifeNursing}" Margin="0,0,0,6" FontSize="12.5"/>
                                <CheckBox IsChecked="{Binding SettingsVm.LifeNursingLenient}" Margin="0,0,0,10" FontSize="12.5">
                                    <TextBlock Text="להקל כדעת &quot;דעת טהרה&quot; - לידה והנקה כמסולקת דמים עד כ&quot;ד חודש" TextWrapping="Wrap" MaxWidth="300"/>
                                </CheckBox>

                                <TextBlock Text="גיל בשנים (לחישוב זקנה וקטנה):" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SettingsVm.LifeAgeYears, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,12"/>

                                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="תקופות נטילת כדורים" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                                        <ItemsControl ItemsSource="{Binding SettingsVm.LifePillPeriods}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <DockPanel Margin="0,0,0,6">
                                                                <Button DockPanel.Dock="Left" Content="🗑" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                        Command="{Binding DataContext.RemovePillPeriodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <TextBlock Text="תקופת כדורים" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </DockPanel>

                                                            <TextBlock Text="סוג הכדורים:" FontSize="11.5" Margin="0,0,0,3"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.PillTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Type, Mode=TwoWay}" Padding="5" Margin="0,0,0,6"/>

                                                            <TextBlock Text="מתאריך:" FontSize="11.5" Margin="0,0,0,3"/>
                                                            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Margin="0,0,0,6"/>

                                                            <TextBlock Text="עד תאריך (ריק = עדיין נוטלת):" FontSize="11.5" Margin="0,0,0,3"/>
                                                            <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Margin="0,0,0,6"/>

                                                            <TextBlock Text="מדוע הפסקתי את הנטילה:" FontSize="11.5" Margin="0,0,0,3"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.PillStopReasonOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                                      SelectedValue="{Binding Reason, Mode=TwoWay}" Padding="5"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ הוסף תקופת כדורים" Command="{Binding SettingsVm.AddPillPeriodCommand}"
                                                Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                Padding="10,6" Cursor="Hand" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Location & Zmanim -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="עיר וזמני היום (שקיעה ונץ)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="לחישוב עונות היום והלילה ובירור ספק עונה:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                            <ComboBox ItemsSource="{Binding SettingsVm.AvailableCities}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SettingsVm.SelectedCityId, Mode=TwoWay}"
                                      Padding="6"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Or Zarua (global custom) + Display Options -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="מנהגים ותצוגה" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>

                            <TextBlock Text="פרופיל מנהג (שכבה נוחה מעל כמה מתגים - שינוי מתג בודד לאחר מכן חוזר ל&quot;מותאם אישית&quot;):" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <ComboBox ItemsSource="{Binding SettingsVm.MinhagProfileOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SettingsVm.MinhagProfile, Mode=TwoWay}"
                                      Padding="6" Margin="0,0,0,12"/>

                            <CheckBox Content="חשש עונת אור זרוע (עונה שלפני)"
                                      IsChecked="{Binding SettingsVm.OrZarua}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="הצגת חלון פוריות וביוץ משוער בלוח"
                                      IsChecked="{Binding SettingsVm.ShowFertility}" Margin="0,0,0,8" FontSize="12.5"/>
                        </StackPanel>
                    </Border>

                    <!-- 3c. Fertility & Ovulation settings (docs/SPEC_FERTILITY_INSIGHTS.md sec.3.5.4) -->
                    <Border Style="{StaticResource SectionCardStyle}"
                            Visibility="{Binding SettingsVm.ShowFertility, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="הגדרות פוריות וביוץ" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>

                            <TextBlock Text="אורך שלב לוטאלי (11-16 יום, ברירת מחדל 14):" FontSize="12" Margin="0,0,0,4"/>
                            <TextBlock Text="לנשים שעברו מעקב ביוץ רפואי ויודעות במדויק את מספר הימים מיום הביוץ ועד הדימום." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding SettingsVm.FertilityLutealPhaseDays, UpdateSourceTrigger=PropertyChanged}" Width="90" HorizontalAlignment="Left" Padding="6" Margin="0,0,0,12"/>

                            <TextBlock Text="בסיס חישוב המחזור:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <RadioButton Content="חישוב אוטומטי לפי ממוצע ההפלגות האחרונות" GroupName="CycleBasisGroup" Margin="0,0,0,4" FontSize="12.5"
                                         IsChecked="{Binding SettingsVm.IsCycleBasisAuto, Mode=TwoWay}"/>
                            <RadioButton Content="אורך מחזור קבוע ידני" GroupName="CycleBasisGroup" Margin="0,0,0,6" FontSize="12.5"
                                         IsChecked="{Binding SettingsVm.IsCycleBasisManual, Mode=TwoWay}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                        Visibility="{Binding SettingsVm.IsCycleBasisManual, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="אורך מחזור (ימים):" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding SettingsVm.FertilityManualCycleDays, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="6"/>
                            </StackPanel>

                            <CheckBox Content="התרע כאשר הביוץ המשוער חל לפני ליל הטבילה"
                                      IsChecked="{Binding SettingsVm.FertilityOvulationConflictAlert}" FontSize="12.5"/>
                        </StackPanel>
                    </Border>

                    <!-- 3b. Halachic Stringencies (13 switches - each a genuine machloket the -->
                    <!-- book presents; the app default is the simpler/lenient side, and any -->
                    <!-- stringency here is an explicit opt-in, never a silent default). -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="חומרות הלכתיות (מחלוקות פוסקים)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="כל מתג כאן הוא מחלוקת אמיתית בספר - ברירת המחדל היא השיטה הפשוטה, וההחמרה היא בחירה מודעת." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <CheckBox Content="ספק עונה - לחוש לשתי העונות"
                                      ToolTip="כשראתה ספק סמוך לחילוף העונות - לחוש אף לעונה הקודמת, ולא לעונה המאוחרת בלבד."
                                      IsChecked="{Binding SettingsVm.SafekOnaBoth}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="וסת הדילוג והסירוג - לחשב חשש"
                                      ToolTip="כשהתבנית מוכחת - לחשב על פיה את יום החשש; אחרת מוצגת לבירור עם רב בלבד."
                                      IsChecked="{Binding SettingsVm.Dilug}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="עקירת וסת שאינו קבוע - לדרוש בדיקה"
                                      ToolTip="כרגע: עבר זמן הוסת ולא ראתה - נעקר מיד. במתג זה: אינו נעקר עד שתיבדק בדיקה כדין."
                                      IsChecked="{Binding SettingsVm.CheckUprootNonFixed}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="עונת אור זרוע בליל יום הל&quot;א"
                                      ToolTip="המנהג להוסיף עונת אור זרוע אף לפני עונה בינונית של יום הל&quot;א. מן הדין אין צריך, ולמעשה יש להחמיר."
                                      IsChecked="{Binding SettingsVm.OrZaruaDay31}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="בדיקה באיחור - מועילה (דעת הב&quot;י)"
                                      ToolTip="כשעבר זמן הוסת ולא נבדקה בו: כבוי = אינה מועילה, וצריך בדיקה בזמנה דוקא."
                                      IsChecked="{Binding SettingsVm.LateBedika}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="מניין ההפלגה - מסוף הראייה"
                                      ToolTip="כשהראייה נמשכה כמה ימים: מניין ברירת המחדל מתחילתה; במתג זה - מסופה."
                                      IsChecked="{Binding SettingsVm.HaflagahFromEnd}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="פחד פתאום - לדרוש בדיקה"
                                      ToolTip="דעת החת&quot;ס שאינה צריכה בדיקה, והגר&quot;ש קלוגר סובר שצריכה בדיקה. כבוי = כחת&quot;ס."
                                      IsChecked="{Binding SettingsVm.FrightBedika}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="כתם - שנחשב עקירת הוסת"
                                      ToolTip="כרגע: הכתם &quot;כמי שאינו לענין וסתות&quot;. במתג זה: כשערי טוהר - כתם שנמצא בזמן הוסת שלש פעמים נחשב עקירה."
                                      IsChecked="{Binding SettingsVm.StainUproots}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="צירוף למפרע - הפלגה ארוכה על פני הפלגה אחרת"
                                      ToolTip="כרגע: וסת ההפלגה נקבעת רק בג' הפלגות רצופות שוות. במתג זה: גם כשבאמצע ראתה בהפלגה קצרה, מצטרפת הווסת הארוכה."
                                      IsChecked="{Binding SettingsVm.ChiburLemafrea}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="וסת הגוף שאינה קבועה - לדרוש בדיקה כשעבר הזמן"
                                      ToolTip="דלוק (ברירת מחדל) = כדעת הט&quot;ז, אסורה עד שתבדוק. כבוי = כדעת הש&quot;ך, אין חומרא יתרה."
                                      IsChecked="{Binding SettingsVm.VesetHagufBedika}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="כרתי ופלתי - עונה בינונית ליממה שלמה"
                                      ToolTip="מנהג אשכנז: הרחבת עונת הפרישה של יום ל' ליממה שלמה - יום ולילה כאחד."
                                      IsChecked="{Binding SettingsVm.KaretiUfaletei}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="וסת מעד בדיקה - דם שנמצא בבדיקה נמנה כראייה"
                                      ToolTip="כרגע: וסת נקבע רק על ידי ראייה כדרכה. במתג זה: גם דם שנמצא בבדיקה (&quot;עד בדיקה&quot;) נמנה כראייה."
                                      IsChecked="{Binding SettingsVm.VesetFromBedika}" Margin="0,0,0,8" FontSize="12.5"/>
                            <CheckBox Content="מאכל חריף - כוסת האונס (לא נספרת לחזקה לבדה)"
                                      ToolTip="כרגע: ראייה מחמת מאכל חריף נספרת לחזקה כוסת הגוף. במתג זה: דינה כוסת האונס, ואינה קובעת וסת לבדה."
                                      IsChecked="{Binding SettingsVm.SharpFoodOnes}" Margin="0,0,0,8" FontSize="12.5"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. PIN Security -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="אבטחת המערכת וקוד PIN" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="נעילת האפליקציה בסיסמה אישית בכל פתיחה:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                            <StackPanel Visibility="{Binding SettingsVm.HasPin, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="הגדרת קוד חדש:" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SettingsVm.NewPin, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,6"/>
                                <TextBlock Text="אימות קוד:" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SettingsVm.ConfirmPin, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"/>
                                <Button Content="שמור קוד PIN" Command="{Binding SettingsVm.UpdatePinCommand}" 
                                        Background="#0F172A" Foreground="#FFFFFF" Padding="10,6" Cursor="Hand"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SettingsVm.HasPin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🔒 המערכת מוגנת בקוד PIN אישי" Foreground="#047857" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8"/>
                                <Button Content="הסר הגנת PIN" Command="{Binding SettingsVm.RemovePinCommand}" 
                                        Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" Padding="10,6" Cursor="Hand"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SettingsVm.PinStatusMessage}" Foreground="#B45309" FontSize="11.5" Margin="0,8,0,0"
                                       Visibility="{Binding SettingsVm.PinStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Local Backup & Restore (JSON) -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="גיבוי ושחזור מקומי (JSON)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="שמירת קובץ גיבוי במחשב או שחזור מגיבוי קודם:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="💾 ייצוא גיבוי לקובץ" Command="{Binding SettingsVm.ExportJsonBackupCommand}"
                                        Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                        Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Content="📂 שחזור מתוך קובץ" Command="{Binding SettingsVm.RestoreJsonBackupCommand}"
                                        Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                        Padding="12,6" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 6. Cloud Backup & Sync -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="גיבוי וסנכרון ענן (חשבון Google)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>

                            <StackPanel Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="חיבור חשבון Google מאפשר גיבוי אוטומטי לגיליון Sheets וסנכרון תזכורות ליומן." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Button Content="🔗 התחבר לחשבון Google" Command="{Binding SettingsVm.ConnectGoogleCommand}"
                                        Background="#0F172A" Foreground="#FFFFFF" Padding="10,6" Cursor="Hand" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Foreground="#047857" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8">
                                    <Run Text="🔗 מחובר"/>
                                    <Run Text="{Binding SettingsVm.GoogleEmail, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="מזהה גיליון Google Sheets:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SettingsVm.SheetId, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📊 פתח את הגיליון" Command="{Binding SettingsVm.OpenGoogleSheetCommand}"
                                            Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                            Padding="10,6" Margin="0,0,8,0" Cursor="Hand"/>
                                    <Button Content="נתק חשבון" Command="{Binding SettingsVm.DisconnectGoogleCommand}"
                                            Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0"
                                            Padding="10,6" Cursor="Hand"/>
                                </StackPanel>

                                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,14"/>

                                <TextBlock Text="כתובת אימייל לשחזור (מוצגת בגיבוי, לזיהוי בעתיד):" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBox Text="{Binding SettingsVm.RecoveryEmail, UpdateSourceTrigger=PropertyChanged}" Padding="6" Width="220" Margin="0,0,8,0"/>
                                    <Button Content="שמור" Command="{Binding SettingsVm.SaveRecoveryEmailCommand}"
                                            Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                            Padding="10,6" Cursor="Hand"/>
                                </StackPanel>

                                <TextBlock Text="הגיבוי לגיליון Sheets אינו אוטומטי בגרסה זו - יש להריץ אותו ידנית, ולשחזר (מיזוג בלבד, בלי למחוק נתונים מקומיים) בעת הצורך:" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="☁️ גבה עכשיו לגוגל" Command="{Binding SettingsVm.BackupToGoogleNowCommand}"
                                            Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                            Padding="10,6" Margin="0,0,8,0" Cursor="Hand"/>
                                    <Button Content="⬇️ שחזר ומזג מגוגל" Command="{Binding SettingsVm.RestoreFromGoogleMergeCommand}"
                                            Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                            Padding="10,6" Cursor="Hand"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SettingsVm.GoogleBackupStatusMessage}" Foreground="#0369A1" FontSize="11.5" Margin="0,8,0,0"
                                           Visibility="{Binding SettingsVm.GoogleBackupStatusMessage.Length, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SettingsVm.GoogleStatusMessage}" Foreground="#0369A1" FontSize="11.5" Margin="0,8,0,0"
                                       Visibility="{Binding SettingsVm.GoogleStatusMessage.Length, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SettingsVm.SyncStatusMessage}" Foreground="#0369A1" FontSize="11.5" Margin="0,4,0,0"
                                       Visibility="{Binding SettingsVm.SyncStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 6c. Google Calendar Sync -->
                    <Border Style="{StaticResource SectionCardStyle}"
                            Visibility="{Binding SettingsVm.GoogleConnected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="יומן גוגל והתראות דוא&quot;ל" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="סנכרון תזכורות בדיקות וימי פרישה ליומן ייעודי ונפרד ביומן Google - היומן הראשי שלך לעולם אינו נגע." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <CheckBox Content="הפעל סנכרון ליומן גוגל" IsChecked="{Binding SettingsVm.CalendarSyncEnabled}" Margin="0,0,0,10" FontSize="12.5"/>

                            <StackPanel Visibility="{Binding SettingsVm.CalendarSyncEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="רמת דיסקרטיות בשם האירוע:" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SettingsVm.CalendarDiscretionOptions}"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding SettingsVm.CalendarDiscretion, Mode=TwoWay}"
                                          Padding="6" Margin="0,0,0,8"/>

                                <StackPanel Visibility="{Binding SettingsVm.CalendarDiscretion, Converter={StaticResource StringEqualsToVis}, ConverterParameter=discreet}">
                                    <TextBlock Text="קידומת מותאמת אישית (למשל: פגישה):" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SettingsVm.CalendarDiscreetPrefix, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8"/>
                                </StackPanel>

                                <CheckBox Content="שלח התראות בדוא&quot;ל" IsChecked="{Binding SettingsVm.CalendarNotifyEmail}" Margin="0,0,0,6" FontSize="12.5"/>
                                <CheckBox Content="הצג התראות פופ-אפ ביומן" IsChecked="{Binding SettingsVm.CalendarNotifyPopup}" Margin="0,0,0,8" FontSize="12.5"/>

                                <TextBlock Text="שעת בדיקת בוקר (HH:MM):" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SettingsVm.CalendarMorningTime, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,8"/>

                                <TextBlock Text="זמן תזכורת דוא&quot;ל לפני השקיעה (בדקות):" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SettingsVm.CalendarSunsetLeadMinutes, Mode=TwoWay}" Padding="6" Margin="0,0,0,8">
                                    <ComboBoxItem Content="30" Tag="30"/>
                                    <ComboBoxItem Content="45" Tag="45"/>
                                    <ComboBoxItem Content="60" Tag="60"/>
                                    <ComboBoxItem Content="120" Tag="120"/>
                                </ComboBox>

                                <CheckBox Content="תזכורת בדיקת מוך דחוק" IsChecked="{Binding SettingsVm.CalendarMochDachukEnabled}" Margin="0,0,0,10" FontSize="12.5"/>

                                <TextBlock Text="שים לב: החיבור הקיים לא בהכרח כולל הרשאת יומן - אם הסנכרון נכשל, נתק וחבר מחדש את החשבון."
                                           FontSize="11" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Visibility="{Binding SettingsVm.CalendarHasScope, Converter={StaticResource InvBoolToVis}}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="🔄 סנכרן כעת" Command="{Binding SettingsVm.SyncCalendarNowCommand}"
                                            Background="#0F172A" Foreground="#FFFFFF" Padding="10,6" Margin="0,0,8,0" Cursor="Hand"/>
                                    <Button Content="📅 פתח את יומן גוגל" Command="{Binding SettingsVm.OpenGoogleCalendarCommand}"
                                            Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                            Padding="10,6" Margin="0,0,8,0" Cursor="Hand"/>
                                    <Button Content="🧹 נקה תזכורות" Command="{Binding SettingsVm.ClearCalendarEventsCommand}"
                                            Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" Padding="10,6" Cursor="Hand"/>
                                </StackPanel>

                                <TextBlock Text="{Binding SettingsVm.CalendarLastSyncMessage}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SettingsVm.CalendarStatusMessage}" Foreground="#0369A1" FontSize="11.5" Margin="0,4,0,0"
                                       Visibility="{Binding SettingsVm.CalendarStatusMessage.Length, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 6b. Error Log -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="יומן תקלות לתמיכה" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10">
                                <Run Text="נרשמו"/>
                                <Run Text="{Binding SettingsVm.ErrorLogCount, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text="תקלות. ייצוא הקובץ ושליחתו לתמיכה עוזר לאבחן בעיה מרחוק."/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="📄 ייצוא יומן תקלות" Command="{Binding SettingsVm.ExportErrorLogCommand}"
                                        Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                        Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Content="🗑 נקה יומן" Command="{Binding SettingsVm.ClearErrorLogCommand}"
                                        Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0"
                                        Padding="12,6" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 6d. Email Data Export -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ייצוא נתונים בדוא&quot;ל" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="שליחת ריכוז נתוני הלוח לכתובת דוא&quot;ל שתבחר/י - למשל כדי לשתף עם רב או לשמור עותק חיצוני." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <TextBlock Text="כתובת דוא&quot;ל לשליחה:" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SettingsVm.ExportEmail, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"/>

                            <TextBlock Text="הודעה (אופציונלי):" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SettingsVm.ExportNotes, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="50"/>

                            <CheckBox Content="נתוני פרישה עתידיים (וסתות, חששות, בדיקות ממתינות)"
                                      IsChecked="{Binding SettingsVm.ExportIncludeFuture}" Margin="0,0,0,6" FontSize="12.5"/>
                            <CheckBox Content="היסטוריית אירועים מלאה"
                                      IsChecked="{Binding SettingsVm.ExportIncludeHistory}" Margin="0,0,0,6" FontSize="12.5"/>
                            <CheckBox Content="כלול הערות אישיות שנרשמו על אירועים"
                                      IsChecked="{Binding SettingsVm.ExportIncludeNotes}" Margin="0,0,0,10" FontSize="12.5"/>

                            <TextBlock Text="שים לב: בפעם הראשונה שנשלח לכתובת זו, יש להיכנס למייל וללחוץ על 'Activate' בהודעה מ-FormSubmit.co כדי שהנתונים יתקבלו בפועל."
                                       FontSize="11" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Button Content="📧 שלח נתונים בדוא&quot;ל" Command="{Binding SettingsVm.SendEmailExportCommand}"
                                    Background="#0F172A" Foreground="#FFFFFF" Padding="10,6" Cursor="Hand" HorizontalAlignment="Left"/>

                            <TextBlock Text="{Binding SettingsVm.ExportStatusMessage}" Foreground="#0369A1" FontSize="11.5" Margin="0,8,0,0"
                                       Visibility="{Binding SettingsVm.ExportStatusMessage.Length, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 6e. Danger Zone: Delete All Data -->
                    <Border Style="{StaticResource SectionCardStyle}" BorderBrush="#FECACA">
                        <StackPanel>
                            <TextBlock Text="⚠ מחיקת כל הנתונים" FontSize="14" FontWeight="Bold" Foreground="#991B1B" Margin="0,0,0,8"/>
                            <TextBlock Text="מוחק לצמיתות את כל האירועים, קוד ה-PIN וכל ההגדרות (מנהג, פוריות, מתגי חומרא, יומן וגיבוי ענן). פעולה זו אינה הפיכה." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding SettingsVm.DeleteAllDataCommand}"
                                        Background="#FEE2E2" Foreground="#991B1B" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="🗑 מחק את כל הנתונים"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SettingsVm.DeleteAllArmed}" Value="True">
                                                    <Setter Property="Content" Value="לחץ שוב לאישור מחיקה סופית"/>
                                                    <Setter Property="Background" Value="#991B1B"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="ביטול" Command="{Binding SettingsVm.CancelDeleteAllDataCommand}"
                                        Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Padding="12,6" Cursor="Hand"
                                        Visibility="{Binding SettingsVm.DeleteAllArmed, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SettingsVm.DeleteAllStatusMessage}" Foreground="#991B1B" FontSize="11.5" Margin="0,8,0,0"
                                       Visibility="{Binding SettingsVm.DeleteAllStatusMessage.Length, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 7. Updates -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="עדכוני תוכנה" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding SettingsVm.CurrentVersionDisplay, StringFormat='גרסה נוכחית: v{0}'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <Button Content="🔄 בדוק עדכונים ב-GitHub" Command="{Binding SettingsVm.CheckUpdatesCommand}"
                                    Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TextMainBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                    Padding="12,6" Cursor="Hand" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding SettingsVm.UpdateStatusMessage}" Foreground="#047857" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0"
                                       Visibility="{Binding SettingsVm.UpdateStatusMessage.Length, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="📥 הורד את הגרסה החדשה" Command="{Binding SettingsVm.OpenReleaseUrlCommand}"
                                    Background="#0F172A" Foreground="#FFFFFF" Padding="10,6" Margin="0,8,0,0" Cursor="Hand" HorizontalAlignment="Left"
                                    Visibility="{Binding SettingsVm.LatestReleaseUrl.Length, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Save Button -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <Button Content="שמור שינויים וסגור" 
                        Command="{Binding SettingsVm.SaveSettingsCommand}" 
                        Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5"
                        Padding="16,10" Cursor="Hand" HorizontalAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</UserControl>














