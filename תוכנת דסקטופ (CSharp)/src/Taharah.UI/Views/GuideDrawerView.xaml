<UserControl x:Class="Taharah.UI.Views.GuideDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="620"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource WindowBgBrush}">
        <Grid Margin="22,18,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Search + categories -->
                <RowDefinition Height="*"/>    <!-- Topics -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <ui:Button DockPanel.Dock="Left" Command="{Binding CloseGuideCommand}"
                           Style="{StaticResource SubtleIconButtonStyle}" ToolTip="סגור (Esc)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <StackPanel>
                    <TextBlock Text="מדריך הלכתי ומאגר מקורות" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="מבוסס &quot;הלכות טהרה&quot; (הרב עמרם פריד), &quot;שיעורי טהרה&quot; ו&quot;דעת טהרה&quot; — מקורות מאומתים"
                               Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Search + category filter -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <ui:TextBox Text="{Binding GuideSearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="חיפוש נושא הלכתי, קוד או מילת מפתח..."
                            ClearButtonEnabled="True"
                            Padding="10,8" FontSize="13" Margin="0,0,0,10"/>

                <!-- WrapPanel ולא פס גלילה אופקי: כל הקטגוריות נראות, בשתי שורות אם צריך -->
                <ItemsControl ItemsSource="{Binding GuideCategories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Content="{Binding}"
                                       Command="{Binding DataContext.FilterGuideCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"
                                       Appearance="Secondary" CornerRadius="14"
                                       Padding="11,5" Margin="0,0,7,7" FontSize="12"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Topics -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,20">
                    <!-- מצב ריק: חיפוש בלי תוצאות -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,44,0,0"
                                Visibility="{Binding FilteredGuideTopics.Count, Converter={StaticResource InvBoolToVis}}">
                        <ui:SymbolIcon Symbol="Search24" FontSize="32" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="לא נמצאו נושאים מתאימים" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,6"/>
                        <TextBlock Text="נסו מילת חיפוש אחרת, או לחצו שוב על קטגוריה כדי לנקות את הסינון."
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding FilteredGuideTopics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Style="{StaticResource AppSectionCardStyle}" Padding="16">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,7">
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource PrimarySubtleBrush}"
                                                    CornerRadius="6" Padding="8,2" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <TextBlock Text="{Binding Summary}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>

                                        <ItemsControl ItemsSource="{Binding Body}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Points}" Margin="12,4,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="•" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,7,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" LineHeight="18"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMainBrush}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="9,6">
                                            <ItemsControl ItemsSource="{Binding Sources}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='מקור: {0}'}" FontSize="11"
                                                                   FontStyle="Italic" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
