<UserControl x:Class="Taharah.UI.Views.GuideDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="500"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Close -->
                <RowDefinition Height="Auto"/> <!-- Search & Category Filter -->
                <RowDefinition Height="*"/>    <!-- Scrollable Topics List -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <DockPanel>
                    <Button DockPanel.Dock="Left" 
                            Command="{Binding CloseGuideCommand}" 
                            Background="Transparent" BorderThickness="0" 
                            Width="32" Height="32" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="מדריך הלכתי ומאגר מקורות" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                        <TextBlock Text="מבוסס 'שיעורי טהרה' ו'דעת טהרה' — מקורות מאומתים" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Search & Filter -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBox Text="{Binding GuideSearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10,8" FontSize="13" Margin="0,0,0,10"
                         BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <!-- Placeholder styling -->
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Category Buttons -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding GuideCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" 
                                        Command="{Binding DataContext.FilterGuideCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}" 
                                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                                        Padding="10,5" Margin="0,0,6,0" Cursor="Hand" FontSize="12">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Topics List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredGuideTopics}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" 
                                    CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" FontWeight="SemiBold"/>

                                    <!-- Body paragraphs -->
                                    <ItemsControl ItemsSource="{Binding Body}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Points -->
                                    <ItemsControl ItemsSource="{Binding Points}" Margin="10,4,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="• " FontSize="12" Foreground="#2563EB" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Sources -->
                                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="4" Padding="8,4" Margin="0,4,0,0">
                                        <ItemsControl ItemsSource="{Binding Sources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat='מקור: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

