<UserControl x:Class="Taharah.UI.Views.VesetSummaryDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="880"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMainBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="CellSubTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- שורת טבלה: פסים לסירוגין (AlternationIndex) + קו תחתון דק -->
        <Style x:Key="SummaryRowBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,8"/>
            <Style.Triggers>
                <DataTrigger Value="1">
                    <DataTrigger.Binding>
                        <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource WindowBgBrush}">
        <Grid Margin="22,18,22,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <ui:Button DockPanel.Dock="Left" Command="{Binding CloseVesetSummaryCommand}"
                           Style="{StaticResource SubtleIconButtonStyle}" ToolTip="סגור (Esc)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24"/>
                    </ui:Button.Icon>
                </ui:Button>
                <StackPanel>
                    <TextBlock Text="ריכוז חישוב וסתות ותאריכי פרישה" Style="{StaticResource TitleTextStyle}"/>
                    <TextBlock Text="כל שורה היא ראייה שנרשמה, עם ההפלגה, העונה הבינונית ויום החודש שנגזרים ממנה."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,22">

                    <!-- מסולקת דמים -->
                    <Border Style="{StaticResource InlineAlertBorderStyle}"
                            Visibility="{Binding HasSilekBanner, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Info24" Margin="0,0,9,0"
                                           VerticalAlignment="Top" Foreground="{DynamicResource WarningFgBrush}"/>
                            <TextBlock Text="{Binding SilekBannerText}" FontSize="12" LineHeight="18"
                                       Foreground="{DynamicResource WarningStrongFgBrush}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <!-- וסת קבוע שנקבע -->
                    <Border Background="{DynamicResource SuccessBgBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14"
                            Visibility="{Binding HasFixedVesetBanner, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Checkmark24" Margin="0,0,9,0"
                                           VerticalAlignment="Top" Foreground="{DynamicResource SuccessFgBrush}"/>
                            <TextBlock Text="{Binding FixedVesetBannerText}" FontSize="12.5" FontWeight="SemiBold"
                                       LineHeight="18" Foreground="{DynamicResource SuccessFgBrush}" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <!-- מצב ריק -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,56,0,0"
                                Visibility="{Binding VesetSummaryRows.Count, Converter={StaticResource InvBoolToVis}}">
                        <ui:SymbolIcon Symbol="DataTrending24" FontSize="34" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="אין עדיין רישומי וסתות" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,6"/>
                        <TextBlock Text="כאשר תזינו תחילת ראייה בלוח השנה, המערכת תציג כאן את תאריכי הפרישה באופן אוטומטי."
                                   FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- טבלה -->
                    <ui:Card Style="{StaticResource AppCardStyle}" Padding="0"
                             Visibility="{Binding VesetSummaryRows.Count, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource InputBgBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1"
                                    CornerRadius="10,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*"/>
                                        <ColumnDefinition Width="0.7*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="תאריך ראייה" Style="{StaticResource ColHeaderStyle}"/>
                                    <TextBlock Grid.Column="1" Text="הפלגה (ימים)" Style="{StaticResource ColHeaderStyle}"/>
                                    <TextBlock Grid.Column="2" Text="עונה בינונית (ל׳ + ל״א)" Style="{StaticResource ColHeaderStyle}"/>
                                    <TextBlock Grid.Column="3" Text="יום החודש" Style="{StaticResource ColHeaderStyle}"/>
                                    <TextBlock Grid.Column="4" Text="הפלגה עתידית" Style="{StaticResource ColHeaderStyle}"/>
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding VesetSummaryRows}" AlternationCount="2">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SummaryRowBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.35*"/>
                                                    <ColumnDefinition Width="0.7*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- תאריך + סטטוס -->
                                                <StackPanel Grid.Column="0" Margin="10,0">
                                                    <TextBlock Text="{Binding DateText}" FontWeight="Bold" FontSize="13"
                                                               Foreground="{DynamicResource TextMainBrush}"/>
                                                    <TextBlock Text="{Binding OnaText}" Style="{StaticResource CellSubTextStyle}"/>
                                                    <Border Background="{DynamicResource HefsekBgBrush}" CornerRadius="6"
                                                            Padding="6,2" Margin="0,5,0,0" HorizontalAlignment="Right"
                                                            Visibility="{Binding IsEstablishing, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock FontSize="10" FontWeight="Bold"
                                                                   Foreground="{DynamicResource HefsekFgBrush}"
                                                                   Text="✓ נקבעת ממנה הוסת"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SignNote}" FontSize="10.5"
                                                               Foreground="{DynamicResource PrishaNightFgBrush}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding SignNote, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>

                                                <!-- הפלגה -->
                                                <TextBlock Grid.Column="1" Text="{Binding HaflagahText}" FontSize="14"
                                                           FontWeight="Bold" Margin="10,0" VerticalAlignment="Top"
                                                           Foreground="{DynamicResource TextMainBrush}"/>

                                                <!-- עונה בינונית -->
                                                <StackPanel Grid.Column="2" Margin="10,0">
                                                    <TextBlock Text="{Binding BeinonitDay30Text}" Style="{StaticResource CellTextStyle}"/>
                                                    <TextBlock Text="{Binding OnaText}" Style="{StaticResource CellSubTextStyle}"/>
                                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0">
                                                        <Run Text="וגם "/>
                                                        <Run Text="{Binding BeinonitDay31Text, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- יום החודש -->
                                                <StackPanel Grid.Column="3" Margin="10,0">
                                                    <TextBlock Text="{Binding YomHachodeshText}" Style="{StaticResource CellTextStyle}"/>
                                                    <Border Background="{DynamicResource WarningBgBrush}"
                                                            BorderBrush="{DynamicResource WarningBorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="6,2"
                                                            Margin="0,5,0,0" HorizontalAlignment="Right"
                                                            Visibility="{Binding YomHachodeshDisputed, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock FontSize="10" FontWeight="Bold" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource WarningFgBrush}"
                                                                   Text="⚠ מחלוקת — יש לשאול רב"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- הפלגה עתידית -->
                                                <StackPanel Grid.Column="4" Margin="10,0">
                                                    <TextBlock Text="{Binding NextHaflagahText}" FontSize="13" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextMainBrush}"/>
                                                    <TextBlock Text="{Binding OnaText}" Style="{StaticResource CellSubTextStyle}"
                                                               Visibility="{Binding NextHaflagahText, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ui:Card>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
