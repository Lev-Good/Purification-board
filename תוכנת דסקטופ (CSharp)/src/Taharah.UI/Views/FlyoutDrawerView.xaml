<UserControl x:Class="Taharah.UI.Views.FlyoutDrawerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Taharah.UI.Converters"
             xmlns:ui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="420"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <converters:OnaTypeToHebrewConverter x:Key="OnaHe"/>

        <!-- ==================== תג סטטוס היום ====================
             Border + TextBlock ולא ui:Badge: ל-Badge אין CornerRadius, ותג סטטוס
             חייב פינות מלאות (כדורית). סדר העדיפויות זהה ל-DetermineDayStatus
             שב-MainViewModel (ראייה > הפסק > טבילה > שבעה נקיים), ולכן הטריגר
             בעל העדיפות הגבוהה ביותר מונח אחרון. -->
        <Style x:Key="DayStatusPillBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedDay.IsShevaNekiyimDay}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NekiimBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NekiimFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDay.IsMikvehNight}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MikvehBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MikvehFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDay.IsHefsekTaharah}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HefsekBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource HefsekFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDay.HasReiya}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SightingBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource SightingFgBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DayStatusPillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedDay.IsShevaNekiyimDay}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource NekiimFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDay.IsMikvehNight}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource MikvehFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDay.IsHefsekTaharah}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource HefsekFgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedDay.HasReiya}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SightingFgBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- פעולות מהירות: שתי עמודות, אייקון + תווית, צבע סמנטי לכל פעולה -->
        <Style x:Key="SightingTileStyle" TargetType="ui:Button" BasedOn="{StaticResource ActionTileButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SightingBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SightingFgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SightingFgBrush}"/>
        </Style>
        <Style x:Key="HefsekTileStyle" TargetType="ui:Button" BasedOn="{StaticResource ActionTileButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource HefsekBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HefsekFgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource HefsekFgBrush}"/>
        </Style>
        <Style x:Key="CheckTileStyle" TargetType="ui:Button" BasedOn="{StaticResource ActionTileButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource NekiimBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NekiimFgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NekiimFgBrush}"/>
        </Style>
        <Style x:Key="MikvehTileStyle" TargetType="ui:Button" BasedOn="{StaticResource ActionTileButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource MikvehBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MikvehFgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MikvehFgBrush}"/>
        </Style>
        <Style x:Key="MarkTileStyle" TargetType="ui:Button" BasedOn="{StaticResource ActionTileButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource MarkBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MarkFgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MarkFgBrush}"/>
        </Style>
        <Style x:Key="SignTileStyle" TargetType="ui:Button" BasedOn="{StaticResource ActionTileButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrishaNightBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrishaNightFgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrishaNightFgBrush}"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1,0,0,0">
        <Grid Margin="18,16,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Day header card -->
                <RowDefinition Height="*"/>    <!-- Scrollable body -->
            </Grid.RowDefinitions>

            <!-- ==================== כותרת היום ==================== -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SelectedDay.HebrewDateFormatted}" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource TextMainBrush}"/>
                    <TextBlock Text="{Binding SelectedDay.GregorianDate, StringFormat='{}{0:dddd, dd בMMMM yyyy}'}"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,9"/>

                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Text="{Binding SelectedDay.Sunrise, StringFormat='נץ {0}'}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Text="{Binding SelectedDay.Sunset, StringFormat='שקיעה {0}'}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border Style="{StaticResource DayStatusPillBorderStyle}">
                            <TextBlock Text="{Binding SelectedDay.StatusSummary}" Style="{StaticResource DayStatusPillTextStyle}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <ui:Button Grid.Column="1" Command="{Binding CloseDrawerCommand}" VerticalAlignment="Top"
                           Style="{StaticResource SubtleIconButtonStyle}" ToolTip="סגור (Esc)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Dismiss24"/>
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <!-- ==================== גוף נגלל ==================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,20">

                    <!-- עונות פרישה וחששות הלכתיים: מסקנת מנוע - תמיד גלויה, לעולם לא מקופלת -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding SelectedDay.ActiveOnot.Count, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="עונות פרישה וחישובים הלכתיים" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,8,0"/>
                        <Border Background="{DynamicResource PrimarySubtleBrush}" CornerRadius="6" Padding="7,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDay.ActiveOnot.Count}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding SelectedDay.ActiveOnot}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InlineAlertBorderStyle}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource PrishaDayFgBrush}"
                                                    CornerRadius="6" Padding="7,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Ona, Converter={StaticResource OnaHe}, StringFormat='עונת {0}'}"
                                                           FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextOnAccentBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Code}" FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarningStrongFgBrush}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Reason}" FontSize="11.5" LineHeight="17"
                                                   Foreground="{DynamicResource WarningStrongFgBrush}"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- רישומים שנשמרו -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,8"
                                Visibility="{Binding SelectedDay.Events.Count, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="רישומים שנשמרו ליום זה" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,8,0"/>
                        <Border Background="{DynamicResource PrimarySubtleBrush}" CornerRadius="6" Padding="7,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDay.Events.Count}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding SelectedDay.Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Style="{StaticResource AppNestedCardStyle}">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Left" Appearance="Transparent" Padding="4"
                                                   Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="מחק רישום זה">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <StackPanel Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Type}" FontWeight="Bold" FontSize="12.5"
                                                           Foreground="{DynamicResource TextMainBrush}"/>
                                                <TextBlock Text="{Binding Ona, Converter={StaticResource OnaHe}, StringFormat=' (עונת {0})'}"
                                                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Notes}" FontSize="11.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                       Visibility="{Binding Notes.Length, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ==================== פעולות מהירות ==================== -->
                    <StackPanel Visibility="{Binding IsFormExpanded, Converter={StaticResource InvBoolToVis}}" Margin="0,14,0,0">
                        <TextBlock Text="פעולות מהירות ליום זה" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2" Margin="0,0,-8,0">
                            <ui:Button Style="{StaticResource SightingTileStyle}"
                                       Command="{Binding ToggleFormCommand}" CommandParameter="ראייה" ToolTip="רישום ראייה חדשה">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Drop24" Margin="0,0,7,0"/>
                                    <TextBlock Text="ראייה חדשה" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Style="{StaticResource HefsekTileStyle}"
                                       Command="{Binding ToggleFormCommand}" CommandParameter="הפסק טהרה" ToolTip="רישום הפסק טהרה">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" Margin="0,0,7,0"/>
                                    <TextBlock Text="הפסק טהרה" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Style="{StaticResource CheckTileStyle}"
                                       Command="{Binding ToggleFormCommand}" CommandParameter="בדיקה" ToolTip="רישום בדיקת שבעה נקיים">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" Margin="0,0,7,0"/>
                                    <TextBlock Text="בדיקת שבעה נקיים" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Style="{StaticResource MikvehTileStyle}"
                                       Command="{Binding ToggleFormCommand}" CommandParameter="טבילה" ToolTip="רישום ליל טבילה">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="WeatherRain24" Margin="0,0,7,0"/>
                                    <TextBlock Text="טבילה במקווה" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Style="{StaticResource MarkTileStyle}"
                                       Command="{Binding ToggleFormCommand}" CommandParameter="כתם/סימון" ToolTip="סימון יום, כתם או הערה">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Edit24" Margin="0,0,7,0"/>
                                    <TextBlock Text="סימון / כתם" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Style="{StaticResource SignTileStyle}"
                                       Command="{Binding ToggleFormCommand}" CommandParameter="מיחוש" ToolTip="מיחוש גופני בלא ראייה">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Pill24" Margin="0,0,7,0"/>
                                    <TextBlock Text="מיחוש גופני" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>
                        </UniformGrid>
                    </StackPanel>

                    <!-- ==================== טופס ההזנה ====================
                         כל שדה, כל קבוצת RadioButton וכל CheckBox נשמרו בדיוק כפי
                         שהיו - אותם CommandParameter, אותם GroupName ואותם
                         Binding paths. הרענון הוא חזותי בלבד: כרטיס, תוויות
                         שדה אחידות, ומקטעי משנה מופרדים בקו דק. -->
                    <ui:Card Style="{StaticResource AppCardStyle}" Margin="0,16,0,0"
                             Visibility="{Binding IsFormExpanded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding NewEntry.EntryType, StringFormat='הזנת {0}'}"
                                       Style="{StaticResource SubtitleTextStyle}" Margin="0,0,0,12"/>

                            <!-- עונה -->
                            <TextBlock Text="עונה הלכתית:" Style="{StaticResource FieldLabelTextStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton Content="עונת יום (מהנץ עד שקיעה)"
                                             IsChecked="{Binding NewEntry.IsDayOna, Mode=TwoWay}"
                                             GroupName="OnaGroup" Margin="0,0,18,0" FontSize="12.5"/>
                                <RadioButton Content="עונת לילה (משקיעה עד נץ)"
                                             IsChecked="{Binding NewEntry.IsNightOna, Mode=TwoWay}"
                                             GroupName="OnaGroup" FontSize="12.5"/>
                            </StackPanel>

                            <!-- ייחודי לראייה -->
                            <StackPanel Visibility="{Binding NewEntry.IsReiyah, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="גורם הראייה:" Style="{StaticResource FieldLabelTextStyle}"/>
                                <RadioButton Content="רגילה — ללא גורם חיצוני"
                                             IsChecked="{Binding NewEntry.IsKindRegular, Mode=TwoWay}"
                                             GroupName="ReiyahKindGroup" Margin="0,0,0,5" FontSize="12.5"/>
                                <RadioButton GroupName="ReiyahKindGroup" IsChecked="{Binding NewEntry.IsKindOnes, Mode=TwoWay}"
                                             Margin="0,0,0,5" FontSize="12.5">
                                    <TextBlock Text="מחמת אונס — אינה נספרת לקביעת וסת" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton Content="מחמת מאכלים חריפים — נספרת כמו וסת הגוף"
                                             IsChecked="{Binding NewEntry.IsKindSharp, Mode=TwoWay}"
                                             GroupName="ReiyahKindGroup" Margin="0,0,0,5" FontSize="12.5"/>
                                <RadioButton Content="מחמת כדורים"
                                             IsChecked="{Binding NewEntry.IsKindPills, Mode=TwoWay}"
                                             GroupName="ReiyahKindGroup" Margin="0,0,0,5" FontSize="12.5"/>
                                <RadioButton GroupName="ReiyahKindGroup" IsChecked="{Binding NewEntry.IsKindKefitza, Mode=TwoWay}"
                                             Margin="0,0,0,12" FontSize="12.5">
                                    <TextBlock Text="מחמת קפיצה — וסת הקפיצות (נספרת לעונה בינונית, ולמסלול קביעה נפרד)" TextWrapping="Wrap"/>
                                </RadioButton>

                                <CheckBox Content="ספק עונה — איני בטוחה אם הראייה הייתה בעונה זו או בקודמתה"
                                          IsChecked="{Binding NewEntry.IsSafekOna}" Margin="0,0,0,7" FontSize="12.5"/>
                                <CheckBox Content="המשך ראייה קודמת (אינו קובע הפלגה)"
                                          IsChecked="{Binding NewEntry.ContinuesPrevious}" Margin="0,0,0,7" FontSize="12.5"/>

                                <CheckBox Content="הדימום נמשך יותר מיום אחד"
                                          IsChecked="{Binding NewEntry.HasMultiDayBleeding}" Margin="0,0,0,7" FontSize="12.5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                            Visibility="{Binding NewEntry.HasMultiDayBleeding, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="כמה ימים סך הכול נמשך הדימום:" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding NewEntry.DurationDays, UpdateSourceTrigger=PropertyChanged}"
                                             Width="64" Padding="6,5"/>
                                </StackPanel>

                                <Border Style="{StaticResource DividerBorderStyle}"/>

                                <TextBlock Text="מיחוש גופני נלווה (וסת הגוף) — אופציונלי:"
                                           Style="{StaticResource FieldLabelTextStyle}"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="פיהוק" IsChecked="{Binding NewEntry.SignYawn}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="עיטוש" IsChecked="{Binding NewEntry.SignSneeze}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="כאבי בטן" IsChecked="{Binding NewEntry.SignCramps}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="כובד ראש ואיברים" IsChecked="{Binding NewEntry.SignHeaviness}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="צמרמורות" IsChecked="{Binding NewEntry.SignChills}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="שופעת דם טמא" IsChecked="{Binding NewEntry.SignBlood}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="בחילה או הקאה" IsChecked="{Binding NewEntry.SignNausea}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="חולשה" IsChecked="{Binding NewEntry.SignWeakness}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="פצעים בפנים" IsChecked="{Binding NewEntry.SignFaceSpots}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="מאכל חריף" IsChecked="{Binding NewEntry.SignSharpFood}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="מיחוש אחר" IsChecked="{Binding NewEntry.SignOther}" Margin="0,0,12,6" FontSize="12"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- ייחודי להפסק טהרה -->
                            <StackPanel Visibility="{Binding NewEntry.IsHefsek, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <CheckBox Content="בדיקת מוך דחוק" IsChecked="{Binding NewEntry.IsMochDachuk}" FontSize="12.5"/>
                            </StackPanel>

                            <!-- ייחודי לבדיקה -->
                            <StackPanel Visibility="{Binding NewEntry.IsCheck, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="עומק הבדיקה:" Style="{StaticResource FieldLabelTextStyle}"/>
                                <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding NewEntry.CheckDepth}"
                                          Padding="6,5" Margin="0,0,0,6">
                                    <ComboBoxItem Content="בדיקה כדין (עומק ובחו&quot;ס)" Tag="deep"/>
                                    <ComboBoxItem Content="קינוח בלבד" Tag="wipe"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- ייחודי לסימוני יום -->
                            <StackPanel Visibility="{Binding NewEntry.IsMark, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <TextBlock Text="סימוני יום (ניתן לסמן כמה בו-זמנית):" Style="{StaticResource FieldLabelTextStyle}"/>
                                <CheckBox Content="מצאתי כתם" IsChecked="{Binding NewEntry.MarkStain}" Margin="0,0,0,7" FontSize="12.5"/>
                                <CheckBox Content="פחד פתאום (ביעתותא)" IsChecked="{Binding NewEntry.MarkFright}" Margin="0,0,0,7" FontSize="12.5"/>
                                <CheckBox Content="חרדה מתמשכת" IsChecked="{Binding NewEntry.MarkAnxiety}" Margin="0,0,0,7" FontSize="12.5"/>
                                <CheckBox Content="יציאה לדרך / בא מן הדרך" IsChecked="{Binding NewEntry.MarkTravel}" Margin="0,0,0,7" FontSize="12.5"/>
                                <CheckBox Content="ליל החופה / בעילת מצוה" IsChecked="{Binding NewEntry.MarkChuppah}" Margin="0,0,0,7" FontSize="12.5"/>
                            </StackPanel>

                            <!-- ייחודי למיחוש בלא ראייה -->
                            <StackPanel Visibility="{Binding NewEntry.IsSign, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Border Style="{StaticResource InlineAlertBorderStyle}">
                                    <TextBlock FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningStrongFgBrush}"
                                               Text="המיחוש עצמו הוא האוסר — &quot;משעה שבאו המיחושים אסורה כדין שעת הוסת&quot;. שלש פעמים לאותו מיחוש קובעות וסת הגוף."/>
                                </Border>

                                <TextBlock Text="סוג המיחוש:" Style="{StaticResource FieldLabelTextStyle}"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox Content="פיהוק" IsChecked="{Binding NewEntry.SignYawn}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="עיטוש" IsChecked="{Binding NewEntry.SignSneeze}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="כאבי בטן" IsChecked="{Binding NewEntry.SignCramps}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="כובד ראש ואיברים" IsChecked="{Binding NewEntry.SignHeaviness}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="צמרמורות" IsChecked="{Binding NewEntry.SignChills}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="שופעת דם טמא" IsChecked="{Binding NewEntry.SignBlood}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="בחילה או הקאה" IsChecked="{Binding NewEntry.SignNausea}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="חולשה" IsChecked="{Binding NewEntry.SignWeakness}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="פצעים בפנים" IsChecked="{Binding NewEntry.SignFaceSpots}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="מאכל חריף" IsChecked="{Binding NewEntry.SignSharpFood}" Margin="0,0,12,6" FontSize="12"/>
                                    <CheckBox Content="מיחוש אחר, משונה" IsChecked="{Binding NewEntry.SignOther}" Margin="0,0,12,6" FontSize="12"/>
                                </WrapPanel>

                                <TextBlock Text="כמה בטוחה שהוסת קרוב?" Style="{StaticResource FieldLabelTextStyle}"/>
                                <RadioButton GroupName="SignCertaintyGroup" Margin="0,0,0,5" FontSize="12"
                                             IsChecked="{Binding NewEntry.IsCertaintyValueCertain, Mode=TwoWay}">
                                    <TextBlock Text="בטוחה שהוסת בא מיד — אסורה עד שתבדוק (ברירת המחדל)" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton GroupName="SignCertaintyGroup" Margin="0,0,0,5" FontSize="12"
                                             IsChecked="{Binding NewEntry.IsCertaintyValueLikely, Mode=TwoWay}">
                                    <TextBlock Text="סביר שהוסת יבוא בין שעה ליממה — מותרת בינתיים, לבדוק בקרוב" TextWrapping="Wrap"/>
                                </RadioButton>
                                <RadioButton GroupName="SignCertaintyGroup" Margin="0,0,0,5" FontSize="12"
                                             IsChecked="{Binding NewEntry.IsCertaintyValueVague, Mode=TwoWay}">
                                    <TextBlock Text="מיחוש רחוק / מסופק — מותרת אחרי בדיקת בגד וקינוח חיצוני" TextWrapping="Wrap"/>
                                </RadioButton>
                            </StackPanel>

                            <!-- הערות -->
                            <TextBlock Text="הערות או פרטים נוספים:" Style="{StaticResource FieldLabelTextStyle}" Margin="0,6,0,4"/>
                            <TextBox Text="{Binding NewEntry.Notes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                                     Padding="8,6" FontSize="12.5" Margin="0,0,0,14"/>

                            <!-- שמירה / ביטול -->
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="שמור (Enter)" Command="{Binding SaveEntryCommand}"
                                           Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Margin="0,0,8,0"/>
                                <ui:Button Content="ביטול (Esc)" Command="{Binding CancelFormCommand}"
                                           Style="{StaticResource AppButtonStyle}" Appearance="Secondary" Padding="14,8"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
