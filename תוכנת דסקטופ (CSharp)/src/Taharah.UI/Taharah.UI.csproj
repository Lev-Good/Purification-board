<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Taharah.Core\Taharah.Core.csproj" />
    <ProjectReference Include="..\Taharah.Infrastructure\Taharah.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF.UI" Version="3.4.2.7" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- No version was ever set here before (defaulted silently to 1.0.0.0), which made
         UpdateCheckerService.cs always report a false "update available" against the shared
         GitHub repo's actual releases (package.json is at 3.2.0). Aligned with that instead of
         inventing a separate C#-only scheme. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>Taharah</AssemblyName>
    <Product>לוח טהרה (הלכות טהרה - הרב עמרם פריד)</Product>
    <Authors>Lev Good</Authors>
    <Version>3.2.0</Version>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
  </PropertyGroup>

</Project>
